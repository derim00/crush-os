+// Matched conversations, most recent first
+int matchedList(int* out) {
+  int n = 0;
+  for (int g = 0; g < numberOfItems(); g++) {
+    if (s_conv[g].matched) {
+      out[n++] = g;
+    }
+  }
+  for (int i = 1; i < n; i++) {
+    int v = out[i];
+    int j = i - 1;
+    while (j >= 0 && s_conv[out[j]].activity < s_conv[v].activity) {
+      out[j + 1] = out[j];
+      j--;
+    }
+    out[j + 1] = v;
+  }
+  return n;
+}
