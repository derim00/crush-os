+// Word-wraps s at maxChars characters per line; returns the number of lines
+int wrap(const char* s, char lines[][40], int maxLines, int maxChars) {
+  char plain[160];
+  plainText(s, plain, sizeof(plain));
+  int n = 0;
+  const char* p = plain;
+  while (*p && n < maxLines) {
+    int len = strlen(p);
+    int cut = len;
+    if (len > maxChars) {
+      cut = maxChars;
+      while (cut > 0 && p[cut] != ' ') {
+        cut--;
+      }
+      if (cut == 0) {
+        cut = maxChars;
+      }
+    }
+    if (cut > 38) {
+      cut = 38;
+    }
+    memcpy(lines[n], p, cut);
+    lines[n][cut] = 0;
+    n++;
+    p += cut;
+    while (*p == ' ') {
+      p++;
+    }
+  }
+  return n;
+}
