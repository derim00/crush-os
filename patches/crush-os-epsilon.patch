+void drawLie(Band& b) {
+  vgradient(b, k_screen, rgb(0x0E2A1F), rgb(0x03100B));
+  toolHeader(b, "Detecteur de mensonges", 0x15965E, 0xFFFFFF);
+  float cx = 160, cy = 150, r = 92;
+  // dial: green (truth) on the left, red (lie) on the right
+  for (int i = 0; i <= 24; i++) {
+    float a = 3.14159f + i * 3.14159f / 24;
+    float a2 = 3.14159f + (i + 1) * 3.14159f / 24;
+    uint32_t col = i < 8 ? 0x1FCF86 : (i < 16 ? 0xF7C948 : 0xFF4458);
+    if (i < 24) {
+      line(b, cx + cosf(a) * r, cy + sinf(a) * r, cx + cosf(a2) * r,
+           cy + sinf(a2) * r, 8, rgb(col));
+    }
+    float in = i % 4 == 0 ? r - 20 : r - 12;
+    line(b, cx + cosf(a) * (r - 6), cy + sinf(a) * (r - 6), cx + cosf(a) * in,
+         cy + sinf(a) * in, 1.5f, rgb(0xFFFFFF), 160);
+  }
+  text(b, "VRAI", 76, 156, rgb(0x1FCF86));
+  text(b, "FAUX", 214, 156, rgb(0xFF4458));
+  // needle
+  float pos = 0.5f;
+  if (k.lieState == 1) {
+    pos = 0.5f + 0.42f * sinf(k.lieT * 0.45f) * sinf(k.lieT * 0.13f + 1.f);
+  } else if (k.lieState == 2) {
+    const float target[4] = {0.1f, 0.88f, 0.98f, 0.5f};
+    pos = target[k.lieResult];
+  }
+  float a = 3.14159f + pos * 3.14159f;
+  line(b, cx, cy, cx + cosf(a) * (r - 16), cy + sinf(a) * (r - 16), 3,
+       rgb(0xFFFFFF));
+  disc(b, static_cast<int>(cx), static_cast<int>(cy), 7, rgb(0xFFFFFF));
+  if (k.lieRig != 0) {
+    // the secret: a single pixel tells you the result is rigged
+    fill(b, {317, 237, 2, 2}, rgb(k.lieRig == 1 ? 0x1FCF86 : 0xFF4458));
+  }
+  const char* msg = "Pose la question. OK = analyser";
+  uint32_t col = 0xCFE9DD;
+  if (k.lieState == 1) {
+    const char* steps[4] = {"Analyse du rythme cardiaque...",
+                            "Mesure de la transpiration...",
+                            "Consultation de ta mere...",
+                            "Verification aupres du CPE..."};
+    msg = steps[(k.lieT / 12) % 4];
+  } else if (k.lieState == 2) {
+    const char* res[4] = {"VERITE.", "MENSONGE !", "GROS MENSONGE !!!",
+                          "Le detecteur a pleure."};
+    const uint32_t cols[4] = {0x1FCF86, 0xFF4458, 0xFF2E74, 0xF7C948};
+    msg = res[k.lieResult];
+    col = cols[k.lieResult];
+  }
+  text(b, msg, 160, 168, rgb(col),
+       k.lieState == 2 ? KDFont::Size::Large : KDFont::Size::Small,
+       Align::Center);
+  if (k.lieState == 2) {
+    text(b, "OK : nouvelle question", 160, 196, rgb(0x7FA898),
+         KDFont::Size::Small, Align::Center);
+  }
+}
