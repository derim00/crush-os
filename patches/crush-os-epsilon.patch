+void drawUpdate(Band& b) {
+  fill(b, k_screen, rgb(0x0A1A3A));
+  uint32_t ms = nowMs() - k.updateStart;
+  float sec = ms / 1000.f;
+  int pct = static_cast<int>(99.f * (1.f - expf(-sec / 25.f)));
+  int whole = static_cast<int>(sec);
+  if (whole % 17 == 16 && pct > 5) {
+    pct -= 3;  // it goes back, of course
+  }
+  // spinner
+  for (int i = 0; i < 8; i++) {
+    float a = (i * 45 + s.phase * 18) * 3.14159f / 180.f;
+    int alpha = 40 + i * 27;
+    disc(b, 160 + static_cast<int>(cosf(a) * 20),
+         70 + static_cast<int>(sinf(a) * 20), 4, rgb(0xFFFFFF), alpha);
+  }
+  text(b, "Mise a jour de Crush 2.0", 160, 108, rgb(0xFFFFFF),
+       KDFont::Size::Large, Align::Center);
+  char p[24];
+  int i = appendInt(p, 0, pct);
+  appendText(p, i, " % effectues");
+  text(b, p, 160, 132, rgb(0xB8C8E8), KDFont::Size::Small, Align::Center);
+  roundFill(b, {40, 152, 240, 6}, 3, rgb(0x22345C));
+  roundFill(b, {40, 152, 240 * pct / 100 + 1, 6}, 3, rgb(0x2BA8FF));
+  text(b, k_update[(whole / 3) % count(k_update)], 160, 168, rgb(0x8FA3C8),
+       KDFont::Size::Small, Align::Center);
+  text(b, "NE PAS ETEINDRE LA CALCULATRICE", 160, 206, rgb(0xFF6B7A),
+       KDFont::Size::Small, Align::Center);
+}
