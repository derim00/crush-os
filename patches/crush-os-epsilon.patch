+void drawStamp(Band& b, Rect card, int kind, int alpha) {
+  if (kind == 0 || alpha <= 0) {
+    return;
+  }
+  const char* label = kind < 0 ? "NOPE" : (kind == 1 ? "LIKE" : "SUPER");
+  uint32_t color = kind < 0 ? k_nope : (kind == 1 ? k_like : k_super);
+  int w = scaledTextWidth(label, 80) + 16;
+  int x = kind < 0 ? card.right() - w - 14
+                   : (kind == 1 ? card.x + 14 : card.x + (card.w - w) / 2);
+  int y = kind == 2 ? card.y + 64 : card.y + 14;
+  Rect r = {x, y, w, 30};
+  roundFill(b, r, 6, rgb(0xFFFFFF), alpha * 210 / 256);
+  roundFrame(b, r, 6, rgb(color), alpha);
+  roundFrame(b, r.inset(1), 5, rgb(color), alpha);
+  roundFrame(b, r.inset(2), 4, rgb(color), alpha);
+  scaledText(b, label, x + 8, y + 4, rgb(color), 80);
+}
+
+void drawCard(Band& b, int g, Rect r, int stamp, int stampAlpha) {
+  if (!r.intersects(b.clip()) || g < 0) {
+    return;
+  }
+  shadow(b, r, 14, 90);
+  roundFill(b, r, 14, rgb(0xFFFFFF));
+  uint32_t color = itemColor(g);
+  Rect ph = {r.x + 6, r.y + 6, r.w - 12, k_photoH};
+  roundFill(b, ph, 10, rgb(color));
+  // light from the top of the photo
+  if (b.setClip(ph.intersection(b.clip()))) {
+    ellipse(b, {ph.x - 30, ph.y - 70, ph.w + 60, 120}, rgb(0xFFFFFF), 46);
+    disc(b, ph.x + ph.w / 2, ph.y + 46, 44, rgb(lighten(color, 90)), 110);
+    // little hearts floating in the photo
+    for (int i = 0; i < 5; i++) {
+      int hx = ph.x + 14 + (i * 47) % (ph.w - 24);
+      int hy = ph.bottom() - ((s.phase * (1 + i % 2) + i * 29) % (ph.h + 10));
+      tinted(b, DsIcons::IconHeartTiny, hx, hy, rgb(0xFFFFFF), 90);
+    }
+    b.resetClip();
+    b.setClip(b.area());
+  }
+  b.resetClip();
+  int bob = static_cast<int>(3 * sinf(s.phase * 0.15f));
+  int cx = ph.x + ph.w / 2;
+  if (!isGame(g)) {
+    const Profile* p = profile(g);
+    int icon = (p ? p->icon : DsIcons::IconGame) + DsIcons::k_artOffset;
+    image(b, icon, cx - 34, ph.y + 6 + bob, 68);
+  } else {
+    roundFill(b, {cx - 34, ph.y + 8 + bob, 68, 68}, 14, rgb(0xFFFFFF), 230);
+    drawItemIcon(b, g, cx - 30, ph.y + 12 + bob, 60);
+  }
+  Conv& c = s_conv[g];
+  if (c.nopes >= 6) {
+    // it cries
+    for (int i = 0; i < 2; i++) {
+      int ty = ph.y + 44 + ((s.phase * 2 + i * 13) % 34);
+      ellipse(b, {cx - 22 + i * 40, ty, 6, 9}, rgb(0x7CC8FF), 220);
+    }
+  }
+  // tags
+  const Profile* p = profile(g);
+  const char* tag1 = p ? p->tag1 : "Gamer";
+  const char* tag2 = p ? p->tag2 : "Addictif";
+  int tw1 = textWidth(tag1) + 14;
+  int tw2 = textWidth(tag2) + 14;
+  pill(b, {ph.x + 6, ph.bottom() - 20, tw1, 16}, 0x000000, 90, tag1, 0xFFFFFF);
+  pill(b, {ph.x + 10 + tw1, ph.bottom() - 20, tw2, 16}, 0x000000, 90, tag2,
+       0xFFFFFF);
+  // name, age
+  int ny = ph.bottom() + 4;
+  const char* label = itemLabel(g);
+  int nw = scaledTextWidth(label, 56);
+  if (nw > r.w - 70) {
+    nw = r.w - 70;
+  }
+  scaledText(b, label, r.x + 12, ny, rgb(k_ink), 56);
+  char age[24];
+  int i = appendText(age, 0, ", ");
+  if (p) {
+    appendText(age, i, p->age);
+  } else {
+    appendInt(age, i, 13 + static_cast<int>(nameHash(g) % 30));
+  }
+  text(b, age, r.x + 14 + nw, ny + 2, rgb(k_grey), KDFont::Size::Large);
+  // verified badge
+  int bx = r.x + 16 + nw + textWidth(age, KDFont::Size::Large) + 6;
+  if (!isGame(g) && bx < r.right() - 12) {
+    disc(b, bx, ny + 10, 6, rgb(k_super));
+    line(b, bx - 3, ny + 10, bx - 1, ny + 12.5f, 1.6f, rgb(0xFFFFFF));
+    line(b, bx - 1, ny + 12.5f, bx + 3, ny + 7.5f, 1.6f, rgb(0xFFFFFF));
+  }
+  // distance
+  tinted(b, DsIcons::IconPin, r.x + 12, ny + 20, rgb(k_grey));
+  text(b, isGame(g) ? "Dans le slot B, tout pres" : "a 0,0001 km (dans ta calc)",
+       r.x + 24, ny + 17, rgb(k_grey));
+  // bio
+  const char* bio1 = p ? p->bio1 : "Jeu .nwa, interdit en examen.";
+  const char* bio2 = p ? p->bio2 : "Cherche joueur pour la perm.";
+  if (c.unmatched) {
+    bio1 = "On s'est deja parle, non ?";
+    bio2 = "Je t'en veux encore un peu.";
+  } else if (c.nopes >= 6) {
+    bio1 = "Je pleure dans mes registres.";
+    bio2 = "S'il te plait. Juste un like.";
+  } else if (c.nopes >= 3) {
+    bio1 = "Tu m'as deja nope 3 fois.";
+    bio2 = "Je reviens quand meme.";
+  }
+  text(b, bio1, r.x + 12, ny + 33, rgb(k_ink), KDFont::Size::Small,
+       Align::Left, r.w - 20);
+  text(b, bio2, r.x + 12, ny + 47, rgb(k_ink), KDFont::Size::Small,
+       Align::Left, r.w - 20);
+  drawStamp(b, r, stamp, stampAlpha);
+}
+
+void drawButton(Band& b, int cx, int r, uint32_t color, int icon, int iconSize,
+                int pressed) {
+  int rr = r + (pressed > 0 ? -2 : 0);
+  shadow(b, {cx - rr, k_buttonsY - rr, 2 * rr, 2 * rr}, rr, 60);
+  disc(b, cx, k_buttonsY, rr, rgb(pressed > 0 ? color : 0xFFFFFF));
+  tinted(b, icon, cx - iconSize / 2, k_buttonsY - iconSize / 2,
+         rgb(pressed > 0 ? 0xFFFFFF : color));
+}
+
+void drawDeck(Band& b) {
+  drawBackground(b, k_content);
+  int n = numberOfItems();
+  if (n == 0) {
+    text(b, "Personne. Meme pas Calculs.", 160, 120, rgb(k_grey),
+         KDFont::Size::Small, Align::Center);
+    return;
+  }
+  // the stack behind
+  Rect back2 = {k_card.x + 16, k_card.y + 12, k_card.w - 32, k_card.h};
+  Rect back1 = {k_card.x + 8, k_card.y + 6, k_card.w - 16, k_card.h};
+  if (n > 2) {
+    shadow(b, back2, 14, 40);
+    roundFill(b, back2, 14, rgb(0xF6E9EF));
+  }
+  if (n > 1) {
+    shadow(b, back1, 14, 50);
+    roundFill(b, back1, 14, rgb(0xFBF2F6));
+  }
+  int dx, dy;
+  cardOffset(&dx, &dy);
+  if ((dx != 0 || dy != 0) && n > 1) {
+    drawCard(b, nextItem(s.top), k_card, 0, 0);
+  }
+  int stampAlpha = 0;
+  int stamp = 0;
+  if (s.swipe != 0) {
+    stamp = s.swipe;
+    stampAlpha = 120 + s.swipeT * 136 / k_swipeFrames;
+  }
+  drawCard(b, s.top, k_card.translated(dx, dy), stamp, stampAlpha);
+  // buttons
+  drawButton(b, 112, 13, k_nope, DsIcons::IconCross, 18, s.press[0]);
+  drawButton(b, 160, 10, k_super, DsIcons::IconStarSmall, 12, s.press[1]);
+  drawButton(b, 208, 13, k_pink, DsIcons::IconHeartMid, 22, s.press[2]);
+  text(b, "<", 88, k_buttonsY - 7, rgb(0xC9AFBC), KDFont::Size::Small,
+       Align::Center);
+  text(b, ">", 232, k_buttonsY - 7, rgb(0xC9AFBC), KDFont::Size::Small,
+       Align::Center);
+}
