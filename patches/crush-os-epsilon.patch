+/* -------------------------------------------------------------- profile */
+
+void drawProfile(Band& b) {
+  drawBackground(b, k_content);
+  Rect card = {10, 30, 300, 204};
+  shadow(b, card, 14, 60);
+  roundFill(b, card, 14, rgb(0xFFFFFF));
+  roundFill(b, {card.x, card.y, card.w, 36}, 14, rgb(k_pink));
+  fill(b, {card.x, card.y + 22, card.w, 14}, rgb(k_pink));
+  disc(b, 52, 74, 33, rgb(0xFFFFFF));
+  image(b, DsIcons::IconYou, 22, 44);
+  scaledText(b, "Toi, 16", 92, 36, rgb(0xFFFFFF), 56);
+  // status
+  int best = -1, worst = -1;
+  for (int g = 0; g < numberOfItems(); g++) {
+    Conv& c = s_conv[g];
+    if (!c.matched) {
+      continue;
+    }
+    if (best < 0 || c.affection > s_conv[best].affection) {
+      best = g;
+    }
+    if (worst < 0 || c.affection < s_conv[worst].affection) {
+      worst = g;
+    }
+  }
+  char status[64];
+  if (best >= 0 && s_conv[best].couple) {
+    format(status, sizeof(status), "En couple avec %s", itemLabel(best));
+  } else if (worst >= 0 && s_conv[worst].affection <= 1) {
+    format(status, sizeof(status), "C'est complique avec %s",
+           itemLabel(worst));
+  } else if (best >= 0) {
+    format(status, sizeof(status), "Ca parle avec %s...", itemLabel(best));
+  } else {
+    format(status, sizeof(status), "Celibataire (mais motive)", "");
+  }
+  text(b, status, 92, 72, rgb(k_pink), KDFont::Size::Small, Align::Left, 214);
+  text(b, "2e rang, pres du radiateur", 92, 88, rgb(k_grey),
+       KDFont::Size::Small, Align::Left, 214);
+  // stats
+  const char* labels[4] = {"likes", "nopes", "matchs", "ruptures"};
+  int values[4] = {s.likes, s.nopes, s.matches, s.breakups};
+  for (int i = 0; i < 4; i++) {
+    Rect r = {20 + i * 71, 112, 66, 40};
+    roundFill(b, r, 10, rgb(0xFFF0F5));
+    char v[8];
+    appendInt(v, 0, values[i]);
+    text(b, v, r.x + r.w / 2, r.y + 2, rgb(k_ink), KDFont::Size::Large,
+         Align::Center);
+    text(b, labels[i], r.x + r.w / 2, r.y + 22, rgb(k_grey),
+         KDFont::Size::Small, Align::Center);
+  }
+  // charm
+  int swipes = s.likes + s.nopes;
+  int charm = swipes == 0 ? 50 : 20 + (s.matches * 80) / swipes;
+  charm -= s.trolls * 5;
+  charm = charm < 1 ? 1 : (charm > 100 ? 100 : charm);
+  char ct[32];
+  int ci = appendText(ct, 0, "Taux de charme : ");
+  ci = appendInt(ct, ci, charm);
+  appendText(ct, ci, "%");
+  text(b, ct, 20, 158, rgb(k_ink));
+  roundFill(b, {20, 176, 280, 8}, 4, rgb(0xF4E1EA));
+  roundFill(b, {20, 176, 280 * charm / 100, 8}, 4, rgb(k_pink));
+  // badges
+  const char* badges[4];
+  int nb = 0;
+  if (s.nopes >= 10) {
+    badges[nb++] = "Briseur de coeurs";
+  }
+  if (s.likes >= 10) {
+    badges[nb++] = "Coeur d'artichaut";
+  }
+  if (s.trolls >= 1) {
+    badges[nb++] = "Traitre TI-83";
+  }
+  if (best >= 0 && s_conv[best].couple) {
+    badges[nb++] = "Fidele";
+  }
+  if (nb == 0) {
+    badges[nb++] = "Debutant de l'amour";
+  }
+  int bx = 20;
+  for (int i = 0; i < nb && i < 3; i++) {
+    int w = textWidth(badges[i]) + 16;
+    if (bx + w > 300) {
+      break;
+    }
+    pill(b, {bx, 196, w, 18}, k_orange, 256, badges[i], 0xFFFFFF);
+    bx += w + 6;
+  }
+  text(b, "Crush Gold : 0 EUR (pas le choix)", 160, 218,
+       rgb(0xC9AFBC), KDFont::Size::Small, Align::Center, 290);
+}
+
+/* ---------------------------------------------------------------- toast */
+
+void drawToast(Band& b) {
+  if (s.toastT <= 0) {
+    return;
+  }
+  char lines[2][40];
+  int nl = wrap(s.toast, lines, 2, 33);
+  int w = 0;
+  for (int l = 0; l < nl; l++) {
+    int lw = textWidth(lines[l]);
+    w = lw > w ? lw : w;
+  }
+  w += 24;
+  int h = 10 + nl * glyphHeight();
+  Rect r = {160 - w / 2, 214 - h, w, h};
+  if (!r.intersects(b.clip())) {
+    return;
+  }
+  int a = s.toastT < 10 ? s.toastT * 25 : 240;
+  roundFill(b, r, 12, rgb(k_ink), a);
+  for (int l = 0; l < nl; l++) {
+    text(b, lines[l], 160, r.y + 5 + l * glyphHeight(), rgb(0xFFFFFF),
+         KDFont::Size::Small, Align::Center);
+  }
+}
+
+// Centred text over up to 2 lines
+void centered(Band& b, const char* str, int y, uint32_t color) {
+  char lines[2][40];
+  int nl = wrap(str, lines, 2, 34);
+  for (int l = 0; l < nl; l++) {
+    text(b, lines[l], 160, y + l * glyphHeight(), rgb(color),
+         KDFont::Size::Small, Align::Center);
+  }
+}
+
+/* --------------------------------------------------------------- match */
+
+void drawMatch(Band& b) {
+  vgradient(b, k_screen, rgb(0x6A1243), rgb(0x16040F));
+  drawHeartsRain(b, 18, 120, k_pink);
+  float t = easeOut(s.matchT / static_cast<float>(k_matchFrames));
+  uint32_t accent = s.superLike ? k_super : k_pink;
+  // title
+  if (s.superLike) {
+    bigText(b, "SUPER", 160, 22, rgb(accent), 2, Align::Center);
+    bigText(b, "CRUSH !", 160, 56, rgb(0xFFFFFF), 2, Align::Center);
+  } else {
+    scaledText(b, "C'EST UN", 160, 20, rgb(0xFFFFFF), 64, Align::Center);
+    bigText(b, "MATCH !", 162, 44, rgb(0x000000), 2, Align::Center);
+    bigText(b, "MATCH !", 160, 42, rgb(accent), 2, Align::Center);
+  }
+  // the two avatars come together
+  int lx = static_cast<int>(-40 + (118 + 40) * t);
+  int rx = static_cast<int>(360 - (360 - 202) * t);
+  int cy = 124;
+  disc(b, lx, cy, 36, rgb(0xFFFFFF));
+  disc(b, lx, cy, 33, rgb(0xFFD3A8));
+  image(b, DsIcons::IconYou, lx - 30, cy - 30);
+  disc(b, rx, cy, 36, rgb(0xFFFFFF));
+  disc(b, rx, cy, 33, rgb(itemColor(s.matchItem)));
+  if (!isGame(s.matchItem)) {
+    const Profile* p = profile(s.matchItem);
+    image(b, (p ? p->icon : DsIcons::IconGame) + DsIcons::k_artOffset, rx - 23,
+          cy - 23, 46);
+  } else {
+    drawItemIcon(b, s.matchItem, rx - 22, cy - 22, 44);
+  }
+  if (s.matchT >= k_matchFrames) {
+    int beat = (s.phase % 14) < 4 ? 3 : 0;
+    disc(b, 160, cy, 18 + beat, rgb(0xFFFFFF));
+    tinted(b, DsIcons::IconHeartMid, 149, cy - 10, rgb(accent));
+  }
+  // what you have in common
+  const Profile* p = profile(s.matchItem);
+  char line1[80];
+  format(line1, sizeof(line1), "Toi et %s :", itemLabel(s.matchItem));
+  text(b, line1, 160, 162, rgb(0xFFC4DA), KDFont::Size::Small, Align::Center);
