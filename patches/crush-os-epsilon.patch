+void drawClock(Band& b) {
+  vgradient(b, k_screen, rgb(0x2A1650), rgb(0x0E0720));
+  toolHeader(b, "Fin du cours", 0x7440D6, 0xFFFFFF);
+  int total = k.clockMinutes * 60;
+  int left = total;
+  if (k.clockRunning) {
+    int elapsed = static_cast<int>((nowMs() - k.clockStart) / 1000);
+    left = total - elapsed;
+    if (left < 0) {
+      left = 0;
+    }
+  }
+  char t[12];
+  int i = appendInt(t, 0, left / 60);
+  t[i++] = ':';
+  t[i++] = '0' + (left % 60) / 10;
+  t[i++] = '0' + left % 10;
+  t[i] = 0;
+  digits(b, t, 160, 48, 56, rgb(0xFFFFFF), Align::Center);
+  if (!k.clockRunning) {
+    text(b, "< >  minutes restantes   OK  demarrer", 160, 124, rgb(0xC7B5EA),
+         KDFont::Size::Small, Align::Center);
+    return;
+  }
+  int pct = total > 0 ? (total - left) * 100 / total : 100;
+  text(b, "Niveau d'ennui", 20, 122, rgb(0xC7B5EA));
+  roundFill(b, {20, 140, 280, 12}, 6, rgb(0x3A2766));
+  roundFill(b, {20, 140, 280 * pct / 100 + 1, 12}, 6,
+            rgb(pct < 60 ? 0xB45CFF : (pct < 90 ? 0xFF7A45 : 0x1FCF86)));
+  const char* stage[] = {"Ca va encore.",
+                         "Tu comptes les dalles du plafond.",
+                         "Tu as relu 4 fois la meme ligne.",
+                         "Ton ame quitte ton corps.",
+                         "Tu ranges ta trousse discretement.",
+                         "LIBERTE IMMINENTE !!!",
+                         "SONNERIE ! COURS !!!"};
+  int st = left == 0 ? 6
+                     : (pct < 20 ? 0
+                                 : (pct < 40 ? 1
+                                             : (pct < 60 ? 2
+                                                         : (pct < 80 ? 3
+                                                                     : (pct < 95 ? 4
+                                                                                 : 5)))));
+  text(b, stage[st], 160, 166, rgb(0xFFFFFF), KDFont::Size::Large,
+       Align::Center, 300);
+  // a face that melts
+  int fx = 160, fy = 212;
+  disc(b, fx, fy, 16, rgb(0xFFD36E));
+  int droop = pct / 25;
+  line(b, fx - 8, fy - 4 + droop / 2, fx - 3, fy - 4, 2, rgb(k_ink));
+  line(b, fx + 3, fy - 4, fx + 8, fy - 4 + droop / 2, 2, rgb(k_ink));
+  if (left == 0) {
+    ring(b, fx, fy + 2, 7, 2, 1.f, rgb(k_ink));
+  } else {
+    line(b, fx - 6, fy + 7, fx + 6, fy + 7 - (droop > 2 ? -2 : 0), 2,
+         rgb(k_ink));
+  }
+}
