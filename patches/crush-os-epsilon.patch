+  wait(60);
+  push(3, MsgJealous, 0, 5);
+  push(5, MsgGhost);
+  key(Events::Two, 4);
+  shoot("messages");
+  key(Events::OK, 2);
+  key(Events::Down, 2);
+  key(Events::Down, 2);
+  key(Events::Up, 2);
