+/* ---------------------------------------------------------- messages */
+
+constexpr int k_rowY = 48;
+constexpr int k_rowH = 38;
+constexpr int k_visibleRows = 5;
+
+void drawHeartsMeter(Band& b, int x, int y, int value) {
+  for (int i = 0; i < 5; i++) {
+    tinted(b, DsIcons::IconHeartTiny, x + i * 10, y,
+           rgb(i < value ? k_pink : 0xE6D3DC));
+  }
+}
+
+void drawMessages(Band& b) {
+  drawBackground(b, k_content);
+  scaledText(b, "Tes matchs", 12, 28, rgb(k_pink), 52);
+  int list[k_maxItems];
+  int n = matchedList(list);
+  if (n == 0) {
+    tinted(b, DsIcons::IconHeart, 136, 80, rgb(0xE9CFDB));
+    text(b, "Aucun match pour l'instant.", 160, 140, rgb(k_ink),
+         KDFont::Size::Small, Align::Center);
+    text(b, "Va swiper, Romeo.", 160, 158, rgb(k_grey), KDFont::Size::Small,
+         Align::Center);
+    return;
+  }
+  char count[16];
+  int i = appendInt(count, 0, n);
+  appendText(count, i, n > 1 ? " matchs" : " match");
+  text(b, count, 308, 31, rgb(k_grey), KDFont::Size::Small, Align::Right);
+  for (int row = 0; row < k_visibleRows; row++) {
+    int idx = s.msgScroll + row;
+    if (idx >= n) {
+      break;
+    }
+    int g = list[idx];
+    Conv& c = s_conv[g];
+    Rect r = {6, k_rowY + row * k_rowH, 308, k_rowH - 2};
+    if (!r.intersects(b.clip())) {
+      continue;
+    }
+    bool sel = idx == s.msgSel;
+    roundFill(b, r, 10, rgb(sel ? 0xFFE0EB : 0xFFFFFF), sel ? 256 : 200);
+    if (sel) {
+      roundFrame(b, r, 10, rgb(k_pink));
+    }
+    drawItemIcon(b, g, r.x + 6, r.y + 3, 30);
+    if (c.couple) {
+      tinted(b, DsIcons::IconHeartSmall, r.x + 28, r.y + 22, rgb(k_pink));
+    }
+    text(b, itemLabel(g), r.x + 44, r.y + 2, rgb(k_ink), KDFont::Size::Large,
+         Align::Left, 150);
+    int m = numberOfMsgs(g);
+    if (m > 0) {
+      char preview[96];
+      const Msg& last = msgAt(g, m - 1);
+      int pi = 0;
+      if (last.me) {
+        pi = appendText(preview, 0, "Toi : ");
+      }
+      msgText(g, last, preview + pi, sizeof(preview) - pi);
+      text(b, preview, r.x + 44, r.y + 20,
+           rgb(c.unread > 0 ? k_ink : k_grey), KDFont::Size::Small,
+           Align::Left, 200);
+    }
+    drawHeartsMeter(b, r.right() - 60, r.y + 7, c.affection);
+    if (c.unread > 0) {
+      disc(b, r.right() - 12, r.y + 26, 5, rgb(k_pink));
+    }
+  }
+}
