+    text(b, "Ton coeur est vide. Reparation...", 24, 206, rgb(0x9A9AA8));
+    static const uint32_t seeds[2] = {0x51A7E, 0x9E3B12};
+    drawBrokenLcd(b, f > 12 ? 2 : 1, seeds);
+    if (f >= k_introCrash - 3) {
+      fill(b, k_screen, rgb(0xFFFFFF), (f - (k_introCrash - 4)) * 70);
+    }
+    return;
+  }
+  // the logo
+  vgradient(b, k_screen, rgb(0xFF4F8B), rgb(0xFF7A45));
+  drawHeartsRain(b, 14, 70, 0xFFFFFF);
+  int beat = (s.phase % 20) < 4 ? 4 : 0;
+  disc(b, 160, 74, 40 + beat, rgb(0xFFFFFF), 60);
+  tinted(b, DsIcons::IconHeart, 136, 50, rgb(0xFFFFFF));
+  bigText(b, "crush", 160, 118, rgb(0xFFFFFF), 3, Align::Center);
+  char t[64];
+  int i = appendInt(t, 0, numberOfItems());
+  appendText(t, i, " applis celib' pres de chez toi");
+  text(b, t, 160, 178, rgb(0xFFFFFF), KDFont::Size::Small, Align::Center);
+  if (f >= k_introFrames && (s.phase / 12) % 2 == 0) {
+    text(b, "Appuie sur OK pour trouver l'amour", 160, 206, rgb(0xFFF0F5),
+         KDFont::Size::Small, Align::Center);
