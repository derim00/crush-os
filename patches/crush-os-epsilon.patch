+namespace {
+
+KDColor s_band[k_screenWidth * Band::k_maxHeight];
+
+/* Text is rasterized white on black in this buffer; the green channel is
+ * then the glyph coverage, used to blend the text over what is below. The
+ * buffer also receives decompressed .nwa icons (never at the same time). */
+constexpr int k_textBufferWidth = 240;
+constexpr int k_textBufferHeight = 18;
+KDColor s_textBuffer[k_textBufferWidth * k_textBufferHeight];
+
+constexpr int k_nwaIconWidth = 55;
+constexpr int k_nwaIconHeight = 56;
+static_assert(k_nwaIconWidth * k_nwaIconHeight <=
+                  k_textBufferWidth * k_textBufferHeight,
+              "The text buffer must be able to hold a .nwa icon");
+
+class TextContext : public KDContext {
+ public:
+  TextContext()
+      : KDContext(KDPointZero,
+                  KDRect(0, 0, k_textBufferWidth, k_textBufferHeight)) {}
+
+ protected:
+  void pushRect(KDRect rect, const KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             pixels + j * rect.width(), rect.width() * sizeof(KDColor));
+    }
+  }
+  void pushRectUniform(KDRect rect, KDColor color) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      KDColor* r = s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x();
+      for (KDCoordinate i = 0; i < rect.width(); i++) {
+        r[i] = color;
+      }
+    }
+  }
+  void pullRect(KDRect rect, KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(pixels + j * rect.width(),
+             s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             rect.width() * sizeof(KDColor));
+    }
+  }
+};
+
+// RGB565 blend in one multiply per pixel, alpha in 0..32
+inline uint16_t fastBlend(uint16_t fg, uint16_t bg, uint32_t a) {
+  uint32_t f = (fg | (static_cast<uint32_t>(fg) << 16)) & 0x07E0F81F;
+  uint32_t k = (bg | (static_cast<uint32_t>(bg) << 16)) & 0x07E0F81F;
+  uint32_t r = ((f * a + k * (32 - a)) >> 5) & 0x07E0F81F;
+  return static_cast<uint16_t>(r | (r >> 16));
+}
+
+inline void blendPixel(KDColor* p, KDColor c, int alpha) {
+  if (alpha >= 248) {
+    *p = c;
+  } else if (alpha >= 4) {
+    *p = KDColor::RGB16(fastBlend(static_cast<uint16_t>(c),
+                                  static_cast<uint16_t>(*p),
+                                  static_cast<uint32_t>(alpha + 4) >> 3));
+  }
+}
+
+}  // namespace
+
+KDColor mix(uint32_t a, uint32_t b, int t256) {
+  int ra = (a >> 16) & 255, ga = (a >> 8) & 255, ba = a & 255;
+  int rb = (b >> 16) & 255, gb = (b >> 8) & 255, bb = b & 255;
+  return KDColor::RGB888(static_cast<uint8_t>(ra + (rb - ra) * t256 / 256),
+                         static_cast<uint8_t>(ga + (gb - ga) * t256 / 256),
+                         static_cast<uint8_t>(ba + (bb - ba) * t256 / 256));
+}
+
+
+/* ------------------------------------------------------------------ rect */
+
+Rect Rect::intersection(const Rect& o) const {
+  int x0 = x > o.x ? x : o.x;
+  int y0 = y > o.y ? y : o.y;
+  int x1 = right() < o.right() ? right() : o.right();
+  int y1 = bottom() < o.bottom() ? bottom() : o.bottom();
+  return {x0, y0, x1 - x0, y1 - y0};
+}
+
+/* ------------------------------------------------------------------ band */
+
+void Band::begin(Rect area) {
+  m_area = area;
+  m_clip = area;
+  m_pixels = s_band;
+}
+
+
+bool Band::setClip(Rect r) {
+  m_clip = r.intersection(m_area);
+  return !m_clip.isEmpty();
+}
+
+KDColor* Band::row(int y) const {
+  return m_pixels + (y - m_area.y) * m_area.w - m_area.x;
+}
+
+const KDColor* Band::pixels() const { return m_pixels; }
+
+/* ------------------------------------------------------------ primitives */
+
+void fill(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    if (alpha >= 256) {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = c;
+      }
+    } else {
+      for (int x = z.x; x < z.right(); x++) {
+        blendPixel(row + x, c, alpha);
+      }
+    }
+  }
+}
+
+void frame(Band& b, Rect r, KDColor c, int alpha) {
+  fill(b, {r.x, r.y, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.bottom() - 1, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.y + 1, 1, r.h - 2}, c, alpha);
+  fill(b, {r.right() - 1, r.y + 1, 1, r.h - 2}, c, alpha);
+}
+
+/* Coverage (0..256) of the pixel (px, py) of a rounded rectangle, 0 outside.
+ * Only the corners are curved; they are antialiased on one pixel. No square
+ * root: near the edge, r - d is about (r^2 - d^2) / 2r. */
+static int roundCoverage(const Rect& r, int radius, int px, int py) {
+  int cx, cy;
+  if (px < r.x + radius) {
+    cx = r.x + radius;
+  } else if (px >= r.right() - radius) {
+    cx = r.right() - radius - 1;
+  } else {
+    return 256;
+  }
+  if (py < r.y + radius) {
+    cy = r.y + radius;
+  } else if (py >= r.bottom() - radius) {
+    cy = r.bottom() - radius - 1;
+  } else {
+    return 256;
+  }
+  // In half pixels, from the corner centre
+  int dx = 2 * (px - cx) + (px < cx ? 1 : -1);
+  int dy = 2 * (py - cy) + (py < cy ? 1 : -1);
+  int d2 = dx * dx + dy * dy;  // (2d)^2
+  int r2 = 2 * radius + 1;     // 2 (r + 0.5)
+  int outer = r2 * r2;
+  if (d2 >= outer) {
+    return 0;
+  }
+  int inner = (r2 - 2) * (r2 - 2);  // 2 (r - 0.5)
+  if (d2 <= inner) {
+    return 256;
+  }
+  return (outer - d2) * 256 / (outer - inner);
+}
+
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  if (radius <= 0) {
+    return fill(b, r, c, alpha);
+  }
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    for (int x = z.x; x < z.right(); x++) {
+      int a = alpha;
+      if (cornerRow) {
+        int cov = roundCoverage(r, radius, x, y);
+        if (cov == 0) {
+          continue;
+        }
+        a = (alpha * cov) >> 8;
+      }
+      blendPixel(row + x, c, a);
+    }
+  }
+}
+
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  Rect inner = r.inset(1);
+  int innerRadius = radius > 1 ? radius - 1 : 0;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    if (!cornerRow) {
+      // Straight sides: one pixel on each side
+      if (r.x >= z.x) {
+        blendPixel(row + r.x, c, alpha);
+      }
+      if (r.right() - 1 < z.right()) {
+        blendPixel(row + r.right() - 1, c, alpha);
+      }
+      continue;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      bool edgeRow = y == r.y || y == r.bottom() - 1;
+      bool inCorner = x < r.x + radius || x >= r.right() - radius;
+      if (!edgeRow && !inCorner) {
+        continue;
+      }
+      int outer = roundCoverage(r, radius, x, y);
+      if (outer == 0) {
+        continue;
+      }
+      int in = inner.contains(x, y) ? roundCoverage(inner, innerRadius, x, y)
+                                    : 0;
+      int cov = outer - in;
+      if (cov > 0) {
+        blendPixel(row + x, c, (alpha * cov) >> 8);
+      }
+    }
+  }
+}
+
+void shadow(Band& b, Rect r, int radius, int strength) {
+  roundFill(b, {r.x - 1, r.y + 2, r.w + 2, r.h + 1}, radius + 1, KDBlack,
+            strength / 3);
+}
+
+void image(Band& b, int icon, int x, int y, int size, int alpha) {
+  const DsIcons::Image& im = DsIcons::k_images[icon];
+  int w = im.width, h = im.height;
+  int dw = size > 0 ? size : w;
+  int dh = size > 0 ? size * h / w : h;
+  Rect z = Rect{x, y, dw, dh}.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  int step = (w << 16) / dw;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int sy = (yy - y) * h / dh;
+    const uint16_t* colors = im.colors + sy * w;
+    const uint8_t* alphas = im.alphas + sy * w;
+    int fx = (z.x - x) * step;
+    for (int xx = z.x; xx < z.right(); xx++, fx += step) {
+      int sx = fx >> 16;
+      int a = alphas[sx];
+      if (a) {
+        blendPixel(row + xx, KDColor::RGB16(colors[sx]),
+                   a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void tinted(Band& b, int icon, int x, int y, KDColor c, int alpha) {
+  const DsIcons::Image& im = DsIcons::k_images[icon];
+  Rect z = Rect{x, y, im.width, im.height}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const uint8_t* alphas = im.alphas + (yy - y) * im.width - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = alphas[xx];
+      if (a) {
+        blendPixel(row + xx, c, a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void tintedScaled(Band& b, int icon, int x, int y, int size, KDColor c,
+                  int alpha) {
+  const DsIcons::Image& im = DsIcons::k_images[icon];
+  int w = im.width, h = im.height;
+  int dh = size * h / w;
+  Rect z = Rect{x, y, size, dh}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    // bilinear: smooth edges when magnified
+    int fy = ((yy - y) * h * 256) / dh;
+    int y0 = fy >> 8, ty = fy & 255;
+    int y1 = y0 + 1 < h ? y0 + 1 : y0;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int fx = ((xx - x) * w * 256) / size;
+      int x0 = fx >> 8, tx = fx & 255;
+      int x1 = x0 + 1 < w ? x0 + 1 : x0;
+      int a00 = im.alphas[y0 * w + x0], a10 = im.alphas[y0 * w + x1];
+      int a01 = im.alphas[y1 * w + x0], a11 = im.alphas[y1 * w + x1];
+      int top = a00 + (a10 - a00) * tx / 256;
+      int bottom = a01 + (a11 - a01) * tx / 256;
+      int a = top + (bottom - top) * ty / 256;
+      if (a) {
+        blendPixel(row + xx, c, a >= 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void disc(Band& b, int cx, int cy, int r, KDColor c, int alpha) {
+  roundFill(b, {cx - r, cy - r, 2 * r, 2 * r}, r, c, alpha);
+}
+
+void ellipse(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  /* Coverage from the normalised squared distance: near the edge,
+   * 1 - d is about (1 - d^2) / 2, antialiased on about one pixel. */
+  float rx = r.w / 2.f, ry = r.h / 2.f;
+  float cx = r.x + rx, cy = r.y + ry;
+  float scale = (rx < ry ? rx : ry) / 2.f;  // 1 - d^2 -> pixels
+  float irx = 1.f / rx, iry = 1.f / ry;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    float dy = (y + 0.5f - cy) * iry;
+    float dy2 = dy * dy;
+    if (dy2 >= 1.f + 1.f / scale) {
+      continue;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      float dx = (x + 0.5f - cx) * irx;
+      float edge = (1.f - dx * dx - dy2) * scale + 0.5f;
+      if (edge <= 0.f) {
+        continue;
+      }
+      int cov = edge >= 1.f ? 256 : static_cast<int>(edge * 256);
+      blendPixel(row + x, c, (alpha * cov) >> 8);
+    }
+  }
+}
+
+void vgradient(Band& b, Rect r, KDColor top, KDColor bottom) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    int t = r.h > 1 ? (y - r.y) * 255 / (r.h - 1) : 0;
+    KDColor c = KDColor::Blend(bottom, top, static_cast<uint8_t>(t));
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      row[x] = c;
+    }
+  }
+}
+
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size) {
+  Rect z = Rect{x, y, size, size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    image(b, DsIcons::IconGame, x, y, size);
+    return;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  // Rounded corners like the other tiles
+  Rect r = {x, y, size, size};
+  int radius = size / 5;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src =
+        s_textBuffer + ((yy - y) * k_nwaIconHeight / size) * k_nwaIconWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int cov = roundCoverage(r, radius, xx, yy);
+      if (cov) {
+        blendPixel(row + xx, src[(xx - x) * k_nwaIconWidth / size], cov);
+      }
+    }
+  }
+}
+
+/* The NumWorks font has no accented letters: French text is written without
+ * accents (é -> e, « » -> "), the way it is typed on the calculator. */
+void plainText(const char* in, char* out, int size) {
+  int n = 0;
+  while (*in && n < size - 1) {
+    uint8_t c = static_cast<uint8_t>(*in);
+    if (c == 0xC3 && in[1]) {
+      uint8_t d = static_cast<uint8_t>(in[1]);
+      const char* map =
+          "AAAAAAACEEEEIIII"  // C3 80..8F
+          "DNOOOOO*OUUUUYTs"  // C3 90..9F
+          "aaaaaaaceeeeiiii"  // C3 A0..AF
+          "dnooooo/ouuuuyty";  // C3 B0..BF
+      if (d >= 0x80 && d <= 0xBF) {
+        char r = map[d - 0x80];
+        if (d == 0x97) {
+          // × exists in the font: keep it
+          if (n + 2 < size) {
+            out[n++] = *in;
+            out[n++] = in[1];
+          }
+        } else {
+          out[n++] = r;
+        }
+        in += 2;
+        continue;
+      }
+    }
+    if (c == 0xC2 && (static_cast<uint8_t>(in[1]) == 0xAB ||
+                      static_cast<uint8_t>(in[1]) == 0xBB)) {
+      out[n++] = '"';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC2 && static_cast<uint8_t>(in[1]) == 0xA0) {
+      out[n++] = ' ';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC5 && (static_cast<uint8_t>(in[1]) == 0x93 ||
+                      static_cast<uint8_t>(in[1]) == 0x92)) {
+      // œ
+      out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'o' : 'O';
+      if (n < size - 1) {
+        out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'e' : 'E';
+      }
+      in += 2;
+      continue;
+    }
+    if (c == 0xE2 && static_cast<uint8_t>(in[1]) == 0x80) {
+      uint8_t d = static_cast<uint8_t>(in[2]);
+      // ’ ‘ -> ', “ ” -> ", … -> ..., – — -> -
+      char r = (d == 0x98 || d == 0x99) ? '\''
+               : (d == 0x9C || d == 0x9D) ? '"'
+               : (d == 0x93 || d == 0x94) ? '-'
+                                          : 0;
+      if (d == 0xA6) {
+        for (int k = 0; k < 3 && n < size - 1; k++) {
+          out[n++] = '.';
+        }
+        in += 3;
+        continue;
+      }
+      if (r) {
+        out[n++] = r;
+        in += 3;
+        continue;
+      }
+    }
+    out[n++] = *in++;
+  }
+  out[n] = 0;
+}
+
+int glyphWidth(KDFont::Size font) { return KDFont::GlyphMaxWidth(font); }
+int glyphHeight(KDFont::Size font) { return KDFont::GlyphHeight(font); }
+
+int textWidth(const char* s, KDFont::Size font) {
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  return KDFont::Font(font)->stringSize(plain).width();
+}
+
+void text(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+          Align align, int maxWidth) {
+  if (s == nullptr || s[0] == 0) {
+    return;
+  }
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  int h = glyphHeight(font);
+  if (y >= b.clip().bottom() || y + h <= b.clip().y) {
+    return;
+  }
+  // Cut the text so that it fits in maxWidth (and in the buffer)
+  constexpr int k_maxChars = 48;
+  char buffer[k_maxChars + 4];
+  int gw = glyphWidth(font);
+  int limit = (maxWidth < k_textBufferWidth ? maxWidth : k_textBufferWidth) / gw;
+  int len = strlen(s);
+  if (limit <= 0) {
+    return;
+  }
+  if (len > limit || len > k_maxChars) {
+    int keep = (limit < k_maxChars ? limit : k_maxChars) - 1;
+    if (keep < 1) {
+      keep = 1;
+    }
+    // Do not cut a UTF-8 sequence in the middle
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    // Cut like the reference ("Calcul", "Equati"), with no ellipsis
+    keep++;
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    memcpy(buffer, s, keep);
+    buffer[keep] = 0;
+    s = buffer;
+  }
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite,
+                  .backgroundColor = KDBlack,
+                  .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + (yy - y) * k_textBufferWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx].green();
+      if (a) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+
+void bigText(Band& b, const char* s, int x, int y, KDColor c, int scale,
+             Align align) {
+  KDFont::Size font = KDFont::Size::Large;
+  char plain[64];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height() : k_textBufferHeight;
+  if (align == Align::Center) {
+    x -= w * scale / 2;
+  } else if (align == Align::Right) {
+    x -= w * scale;
+  }
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite, .backgroundColor = KDBlack, .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    // Bilinear sampling of the coverage, for smooth big digits
+    int fy = ((yy - y) * 256 + 128) / scale - 128;
+    int y0 = fy >> 8, ty = fy & 255;
+    if (fy < 0) {
+      y0 = 0;
+      ty = 0;
+    }
+    int y1 = y0 + 1 < h ? y0 + 1 : y0;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int fx = ((xx - x) * 256 + 128) / scale - 128;
+      int x0 = fx >> 8, tx = fx & 255;
+      if (fx < 0) {
+        x0 = 0;
+        tx = 0;
+      }
+      int x1 = x0 + 1 < w ? x0 + 1 : x0;
+      int a00 = s_textBuffer[y0 * k_textBufferWidth + x0].green();
+      int a10 = s_textBuffer[y0 * k_textBufferWidth + x1].green();
+      int a01 = s_textBuffer[y1 * k_textBufferWidth + x0].green();
+      int a11 = s_textBuffer[y1 * k_textBufferWidth + x1].green();
+      int top = a00 + (a10 - a00) * tx / 256;
+      int bottom = a01 + (a11 - a01) * tx / 256;
+      int a = top + (bottom - top) * ty / 256;
+      // Sharpen the edges a little
+      a = (a - 64) * 2;
+      if (a > 0) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+
+/* ------------------------------------------------------------ scaled text */
+
+int scaledTextWidth(const char* s, int scale64) {
+  return textWidth(s, KDFont::Size::Large) * scale64 / 64;
+}
+
+void scaledText(Band& b, const char* s, int x, int y, KDColor c, int scale64,
+                Align align) {
+  if (scale64 <= 0 || s == nullptr || s[0] == 0) {
+    return;
+  }
+  KDFont::Size font = KDFont::Size::Large;
+  char plain[64];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height() : k_textBufferHeight;
+  int dw = w * scale64 / 64, dh = h * scale64 / 64;
+  if (align == Align::Center) {
+    x -= dw / 2;
+  } else if (align == Align::Right) {
+    x -= dw;
+  }
+  Rect z = Rect{x, y, dw, dh}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite, .backgroundColor = KDBlack, .font = font});
+  bool sharpen = scale64 > 96;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int fy = ((yy - y) * 64 * 256 + 32 * 256) / scale64 - 128;
+    if (fy < 0) {
+      fy = 0;
+    }
+    int y0 = fy >> 8, ty = fy & 255;
+    if (y0 >= h) {
+      continue;
+    }
+    int y1 = y0 + 1 < h ? y0 + 1 : y0;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int fx = ((xx - x) * 64 * 256 + 32 * 256) / scale64 - 128;
+      if (fx < 0) {
+        fx = 0;
+      }
+      int x0 = fx >> 8, tx = fx & 255;
+      if (x0 >= w) {
+        continue;
+      }
+      int x1 = x0 + 1 < w ? x0 + 1 : x0;
+      int a00 = s_textBuffer[y0 * k_textBufferWidth + x0].green();
+      int a10 = s_textBuffer[y0 * k_textBufferWidth + x1].green();
+      int a01 = s_textBuffer[y1 * k_textBufferWidth + x0].green();
+      int a11 = s_textBuffer[y1 * k_textBufferWidth + x1].green();
+      int top = a00 + (a10 - a00) * tx / 256;
+      int bottom = a01 + (a11 - a01) * tx / 256;
+      int a = top + (bottom - top) * ty / 256;
+      if (sharpen) {
+        a = (a - 70) * 2;
+      }
+      if (a > 0) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+/* ------------------------------------------------------- lines and rings */
+
+static inline float clampf(float v, float lo, float hi) {
+  return v < lo ? lo : (v > hi ? hi : v);
+}
+
+void line(Band& b, float x0, float y0, float x1, float y1, float width,
+          KDColor c, int alpha) {
+  float hw = width / 2.f;
+  int minX = static_cast<int>(floorf((x0 < x1 ? x0 : x1) - hw - 1));
+  int maxX = static_cast<int>(ceilf((x0 > x1 ? x0 : x1) + hw + 1));
+  int minY = static_cast<int>(floorf((y0 < y1 ? y0 : y1) - hw - 1));
+  int maxY = static_cast<int>(ceilf((y0 > y1 ? y0 : y1) + hw + 1));
+  Rect z = Rect{minX, minY, maxX - minX, maxY - minY}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  float dx = x1 - x0, dy = y1 - y0;
+  float len2 = dx * dx + dy * dy;
+  float inv = len2 > 0.0001f ? 1.f / len2 : 0.f;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    float py = yy + 0.5f;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      float px = xx + 0.5f;
+      float t = clampf(((px - x0) * dx + (py - y0) * dy) * inv, 0.f, 1.f);
+      float ex = px - (x0 + t * dx), ey = py - (y0 + t * dy);
+      float d = sqrtf(ex * ex + ey * ey);
+      float cov = clampf(hw + 0.5f - d, 0.f, 1.f);
+      if (cov > 0.f) {
+        blendPixel(row + xx, c, static_cast<int>(cov * alpha));
+      }
+    }
+  }
+}
+
+void ring(Band& b, float cx, float cy, float r, float width, float fraction,
+          KDColor c, int alpha) {
+  if (fraction <= 0.f) {
+    return;
+  }
+  float hw = width / 2.f;
+  int ext = static_cast<int>(r + hw + 2);
+  Rect z = Rect{static_cast<int>(cx) - ext, static_cast<int>(cy) - ext,
+                2 * ext, 2 * ext}
+               .intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  bool full = fraction >= 1.f;
+  float endAngle = fraction * 2.f * static_cast<float>(M_PI);
+  float ex = cx + r * sinf(endAngle), ey = cy - r * cosf(endAngle);
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    float py = yy + 0.5f - cy;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      float px = xx + 0.5f - cx;
+      float d = sqrtf(px * px + py * py);
+      float cov = clampf(hw + 0.5f - fabsf(d - r), 0.f, 1.f);
+      if (cov <= 0.f) {
+        continue;
+      }
+      if (!full) {
+        float a = atan2f(px, -py);
+        if (a < 0.f) {
+          a += 2.f * static_cast<float>(M_PI);
+        }
+        if (a > endAngle) {
+          // Round caps at both ends
+          float sx = px, sy = py + r;
+          float qx = xx + 0.5f - ex, qy = yy + 0.5f - ey;
+          float dc = sqrtf(sx * sx + sy * sy);
+          float de = sqrtf(qx * qx + qy * qy);
+          float m = dc < de ? dc : de;
+          cov = clampf(hw + 0.5f - m, 0.f, 1.f);
+          if (cov <= 0.f) {
+            continue;
+          }
+        }
+      }
+      blendPixel(row + xx, c, static_cast<int>(cov * alpha));
+    }
+  }
+}
+
+void warmFilter(Band& b, int strength) {
+  const Rect& z = b.clip();
+  int gk = 1024 - strength;      // green down to 75 %
+  int bk = 512 - strength;       // blue down to 50 %
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      uint16_t v = static_cast<uint16_t>(row[x]);
+      int g = (v >> 5) & 63, bl = v & 31;
+      g = g * gk / 1024;
+      bl = bl * bk / 512;
+      row[x] = KDColor::RGB16((v & 0xF800) | (g << 5) | bl);
+    }
+  }
+}
+
+/* --------------------------------------------------------- vector digits */
+
+namespace {
+
+struct Pen {
+  Band* b;
+  float ox, oy, w, h, sw;
+  KDColor c;
+  int alpha;
+  float px, py;
+  bool has;
+  void move(float x, float y) {
+    px = ox + x * w;
+    py = oy + y * h;
+    has = true;
+  }
+  void to(float x, float y) {
+    float nx = ox + x * w, ny = oy + y * h;
+    if (has) {
+      line(*b, px, py, nx, ny, sw, c, alpha);
+    }
+    px = nx;
+    py = ny;
+    has = true;
+  }
+  void arc(float cx, float cy, float rx, float ry, float a0, float a1,
+           int steps) {
+    for (int i = 0; i <= steps; i++) {
+      float a = (a0 + (a1 - a0) * i / steps) * static_cast<float>(M_PI) / 180.f;
+      float x = cx + rx * cosf(a), y = cy + ry * sinf(a);
+      if (i == 0) {
+        move(x, y);
+      } else {
+        to(x, y);
+      }
+    }
+  }
+  void dot(float x, float y, float r) {
+    disc(*b, static_cast<int>(ox + x * w), static_cast<int>(oy + y * h),
+         static_cast<int>(r), c, alpha);
+  }
+};
+
+float charWidth(char ch, int h) {
+  switch (ch) {
+    case ':':
+    case ',':
+    case '.':
+      return h * 0.3f;
+    case '-':
+      return h * 0.5f;
+    case ' ':
+      return h * 0.3f;
+    default:
+      return h * 0.62f;
+  }
+}
+
+constexpr float k_digitGap = 0.16f;
+
+}  // namespace
+
+int digitsWidth(const char* s, int h) {
+  float w = 0.f;
+  int n = 0;
+  for (const char* p = s; *p; p++) {
+    if (static_cast<uint8_t>(*p) == 0xC2) {
+      continue;
+    }
+    if (static_cast<uint8_t>(*p) == 0xB0) {
+      w += h * 0.36f;
+    } else {
+      w += charWidth(*p, h);
+    }
+    n++;
+  }
+  return static_cast<int>(w + (n > 1 ? (n - 1) * h * k_digitGap : 0.f));
+}
+
+void digits(Band& b, const char* s, int x, int y, int h, KDColor c, Align align,
+            int alpha) {
+  int total = digitsWidth(s, h);
+  if (align == Align::Center) {
+    x -= total / 2;
+  } else if (align == Align::Right) {
+    x -= total;
+  }
+  if (!Rect{x - h / 4, y - h / 4, total + h / 2, h + h / 2}.intersects(b.clip())) {
+    return;
+  }
+  float sw = h * 0.085f;
+  if (sw < 1.6f) {
+    sw = 1.6f;
+  }
+  float cx = static_cast<float>(x);
+  for (const char* p = s; *p; p++) {
+    uint8_t ch = static_cast<uint8_t>(*p);
+    if (ch == 0xC2) {
+      continue;
+    }
+    float cw = ch == 0xB0 ? h * 0.36f : charWidth(*p, h);
+    // The box of the strokes' centres, inside the glyph
+    Pen pen = {&b, cx + sw / 2, y + sw / 2, cw - sw, h - sw, sw, c, alpha, 0, 0, false};
+    if (Rect{static_cast<int>(cx) - 2, y - 2, static_cast<int>(cw) + 4, h + 4}.intersects(b.clip())) {
+      switch (ch) {
+        case '0':
+          pen.arc(0.5f, 0.5f, 0.5f, 0.5f, 0, 360, 30);
+          break;
+        case '1':
+          pen.move(0.12f, 0.22f);
+          pen.to(0.62f, 0.f);
+          pen.to(0.62f, 1.f);
+          break;
+        case '2':
+          pen.arc(0.5f, 0.27f, 0.48f, 0.27f, 185, 385, 16);
+          pen.to(0.f, 1.f);
+          pen.to(1.f, 1.f);
+          break;
+        case '3':
+          pen.arc(0.48f, 0.25f, 0.44f, 0.25f, 200, 450, 16);
+          pen.arc(0.5f, 0.73f, 0.5f, 0.27f, 270, 520, 16);
+          break;
+        case '4':
+          pen.move(0.74f, 1.f);
+          pen.to(0.74f, 0.f);
+          pen.to(0.f, 0.68f);
+          pen.to(1.f, 0.68f);
+          break;
+        case '5':
+          pen.move(0.92f, 0.f);
+          pen.to(0.16f, 0.f);
+          pen.to(0.08f, 0.47f);
+          pen.arc(0.5f, 0.67f, 0.48f, 0.33f, 218, 510, 20);
+          break;
+        case '6':
+          pen.arc(0.5f, 0.68f, 0.48f, 0.32f, 0, 360, 24);
+          pen.has = false;
+          pen.arc(0.97f, 0.66f, 0.93f, 0.64f, 180, 252, 8);
+          break;
+        case '7':
+          pen.move(0.f, 0.f);
+          pen.to(1.f, 0.f);
+          pen.to(0.34f, 1.f);
+          break;
+        case '8':
+          pen.arc(0.5f, 0.25f, 0.42f, 0.25f, 0, 360, 22);
+          pen.has = false;
+          pen.arc(0.5f, 0.73f, 0.5f, 0.27f, 0, 360, 24);
+          break;
+        case '9':
+          pen.arc(0.5f, 0.32f, 0.48f, 0.32f, 0, 360, 24);
+          pen.has = false;
+          pen.arc(0.03f, 0.34f, 0.93f, 0.64f, 0, 72, 8);
+          break;
+        case ':':
+          pen.dot(0.5f, 0.3f, sw * 0.75f);
+          pen.dot(0.5f, 0.78f, sw * 0.75f);
+          break;
+        case '.':
+          pen.dot(0.5f, 0.95f, sw * 0.75f);
+          break;
+        case ',':
+          pen.move(0.6f, 0.86f);
+          pen.to(0.35f, 1.12f);
+          break;
+        case '-':
+          pen.move(0.05f, 0.58f);
+          pen.to(0.95f, 0.58f);
+          break;
+        case 0xB0:
+          pen.sw = sw * 0.8f;
+          pen.arc(0.5f, 0.14f, h * 0.11f / (cw - sw), h * 0.11f / (h - sw), 0, 360, 16);
+          break;
+        default:
+          break;
+      }
+    }
+    cx += cw + h * k_digitGap;
+  }
+}
+
+}  // namespace Ds
+}  // namespace Home
