+  shoot("nope");
+  wait(5, "gifswipe");
+  key(Events::Right, 3, "gifswipe");
+  s.swipe = 1;
+  s.swipeT = 3;
+  shoot("like");
+  wait(4, "gifswipe");
+  wait(22, "gifswipe");
+  shoot("match");
+  key(Events::Back, 4, "gifswipe");
+  key(Events::Up, 30, "gifswipe");
+  shoot("superlike");
