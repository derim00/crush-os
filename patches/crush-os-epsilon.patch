+/* -------------------------------------------------------------- cracks */
+
+void crackLines(Band& b, uint32_t seed, float cx, float cy, bool ring) {
+  uint32_t r = seed;
+  auto next = [&r]() {
+    r = r * 1103515245u + 12345u;
+    return static_cast<float>((r >> 16) & 0x7FFF) / 32768.f;
+  };
+  int rays = 7 + static_cast<int>(next() * 5);
+  float ringPts[16][2];
+  for (int i = 0; i < rays; i++) {
+    float a = (i + next() * 0.7f) * 6.2832f / rays;
+    float x = cx, y = cy;
+    int segs = 3 + static_cast<int>(next() * 4);
+    for (int k2 = 0; k2 < segs; k2++) {
+      float len = 14 + next() * 36;
+      a += (next() - 0.5f) * 0.7f;
+      float nx = x + cosf(a) * len, ny = y + sinf(a) * len;
+      line(b, x + 1, y + 1, nx + 1, ny + 1, 1.3f, rgb(0x000000), 110);
+      line(b, x, y, nx, ny, 1.1f, rgb(0xFFFFFF), 235);
+      if (k2 == 0 && i < 16) {
+        ringPts[i][0] = nx;
+        ringPts[i][1] = ny;
+      }
+      if (next() < 0.35f) {
+        float ba = a + (next() - 0.5f) * 1.8f;
+        float bl = 8 + next() * 18;
+        line(b, nx, ny, nx + cosf(ba) * bl, ny + sinf(ba) * bl, 0.9f,
+             rgb(0xFFFFFF), 200);
+      }
+      x = nx;
+      y = ny;
+    }
+  }
+  if (ring) {
+    int n = rays < 16 ? rays : 16;
+    for (int i = 0; i < n; i++) {
+      int j = (i + 1) % n;
+      line(b, ringPts[i][0], ringPts[i][1], ringPts[j][0], ringPts[j][1], 1.f,
+           rgb(0xFFFFFF), 170);
+    }
+  }
+  // the impact point
+  disc(b, static_cast<int>(cx), static_cast<int>(cy), 5, rgb(0xFFFFFF), 160);
+}
+
+void drawBrokenLcd(Band& b, int impacts, const uint32_t* seeds) {
+  // ink leaking from a corner, dead pixel lines
+  disc(b, 286, 30, 52, rgb(0x05030A), 250);
+  disc(b, 262, 58, 30, rgb(0x05030A), 230);
+  disc(b, 300, 74, 26, rgb(0x0A0614), 220);
+  ring(b, 286, 30, 54, 3, 1.f, rgb(0x5B2BFF), 150);
+  ring(b, 262, 58, 32, 2, 1.f, rgb(0x00C2FF), 110);
+  fill(b, {214, 0, 1, 240}, rgb(0xFF00D4), 220);
+  fill(b, {229, 0, 2, 240}, rgb(0x00FF6A), 200);
+  fill(b, {71, 0, 1, 240}, rgb(0xFFFFFF), 160);
+  fill(b, {0, 151, 320, 1}, rgb(0x00E1FF), 140);
+  for (int i = 0; i < impacts; i++) {
+    uint32_t sd = seeds[i];
+    float cx = 40 + (sd % 240);
+    float cy = 40 + ((sd >> 8) % 160);
+    if (i == 0) {
+      cx = 118;
+      cy = 104;
+    }
+    crackLines(b, sd, cx, cy, true);
+  }
+}
