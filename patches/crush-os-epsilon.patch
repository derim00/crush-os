+        if ART and name != "CodeArt":
+            # white symbol: coloured holes become see-through
+            px = img.load()
+            for y in range(img.height):
+                for x in range(img.width):
+                    r, g, b, a = px[x, y]
+                    px[x, y] = (255, 255, 255, a * min(r, g, b) // 255)
+        images.append((name, img))
+    ART = False
+    lines = [
+        "// Generated by apps/home/ds/gen_icons.py - do not edit",
+        "#pragma once",
+        "#include <stdint.h>",
+        "",
+        "namespace Home {",
+        "namespace DsIcons {",
+        "",
+        "struct Image {",
+        "  uint8_t width;",
+        "  uint8_t height;",
+        "  const uint16_t* colors;",
+        "  const uint8_t* alphas;",
+        "};",
+        "",
+        "enum Icon : uint8_t {",
+    ]
+    for i, (name, _) in enumerate(images):
+        lines.append(f"  Icon{name} = {i},")
+    lines += [f"  NumberOfIcons = {len(images)}", "};", "",
+              f"constexpr int k_smallOffset = IconCalculationSmall - IconCalculation;",
+              f"constexpr int k_artOffset = IconCalculationArt - IconCalculation;", ""]
+    for name, img in images:
+        px = img.load()
+        w, h = img.size
+        colors, alphas = [], []
+        for y in range(h):
+            for x in range(w):
+                r, g, b, a = px[x, y]
+                if a == 0:
+                    r = g = b = 0
+                colors.append(rgb565(r, g, b))
+                alphas.append(a)
+        lines.append(f"constexpr uint16_t k_{name}Colors[{w * h}] = {{")
+        for i in range(0, len(colors), 24):
+            lines.append("  " + ", ".join(str(v) for v in colors[i:i + 24]) + ",")
+        lines.append("};")
+        lines.append(f"constexpr uint8_t k_{name}Alphas[{w * h}] = {{")
+        for i in range(0, len(alphas), 32):
+            lines.append("  " + ", ".join(str(v) for v in alphas[i:i + 32]) + ",")
+        lines.append("};")
+    lines.append(f"constexpr Image k_images[{len(images)}] = {{")
+    for name, img in images:
+        w, h = img.size
+        lines.append(f"  {{{w}, {h}, k_{name}Colors, k_{name}Alphas}},")
+    lines += ["};", "", "}  // namespace DsIcons", "}  // namespace Home", ""]
+    with open(out, "w") as f:
+        f.write("\n".join(lines))
+    if preview:
+        scale = 4
+        cols = 8
+        cell = 80
+        rows = (len(images) + cols - 1) // cols
+        sheet = Image.new("RGBA", (cols * cell * scale, rows * cell * scale), hexc(0xE8EBEF))
+        for i, (_, img) in enumerate(images):
+            big = img.resize((img.width * scale, img.height * scale), Image.NEAREST)
