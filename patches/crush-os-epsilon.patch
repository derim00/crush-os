+/* ---------------------------------------------------------------- chat */
+
+constexpr Rect k_chatHead = {0, 0, 320, 34};
+constexpr Rect k_chatBody = {0, 34, 320, 130};
+constexpr Rect k_chatReplies = {0, 164, 320, 76};
+constexpr int k_wrapChars = 26;
+
+void replyText(int i, char* out, int size) {
+  Conv& c = s_conv[s.chat];
+  int var = (c.count + s.chat) % k_variants;
+  if (i == 0) {
+    format(out, size, "Rendez-vous ? (ouvrir l'appli)", "");
+  } else if (i == 1) {
+    format(out, size, k_meCute[var], "");
+  } else {
+    format(out, size, k_meTroll[var], "");
+  }
+}
+
+void drawChat(Band& b) {
+  int g = s.chat;
+  Conv& c = s_conv[g];
+  // header
+  if (b.area().intersects(k_chatHead)) {
+    fill(b, k_chatHead, rgb(0xFFFFFF));
+    fill(b, {0, 33, 320, 1}, rgb(k_soft));
+    line(b, 13, 17, 8, 12, 2.2f, rgb(k_pink));
+    line(b, 8, 12, 13, 7, 2.2f, rgb(k_pink));
+    // keep the chevron centred
+    drawItemIcon(b, g, 22, 2, 30);
+    text(b, itemLabel(g), 60, 0, rgb(k_ink), KDFont::Size::Large, Align::Left,
+         170);
+    if (s.typing > 0 && s.pending >= 0) {
+      text(b, "en train d'ecrire...", 60, 18, rgb(k_pink));
+    } else {
+      disc(b, 64, 25, 3, rgb(k_like));
+      text(b, c.couple ? "en couple avec toi" : "en ligne", 71, 18,
+           rgb(k_grey));
+    }
+    drawHeartsMeter(b, 262, 13, c.affection);
+  }
+  // body
+  if (b.area().intersects(k_chatBody)) {
+    fill(b, k_chatBody, rgb(0xFFF7FA));
+    if (b.setClip(k_chatBody.intersection(b.area()))) {
+      int y = k_chatBody.bottom() - 4;
+      int lh = glyphHeight();
+      if (s.typing > 0 && s.pending >= 0) {
+        Rect bub = {8, y - 22, 46, 22};
+        roundFill(b, bub, 11, rgb(0xEDE1E7));
+        for (int d = 0; d < 3; d++) {
+          int up = ((s.phase / 3) % 3) == d ? 3 : 0;
+          disc(b, bub.x + 13 + d * 10, bub.y + 11 - up, 3, rgb(k_grey));
+        }
+        y -= 28;
+      }
+      for (int i = numberOfMsgs(g) - 1; i >= 0 && y > k_chatBody.y; i--) {
+        const Msg& m = msgAt(g, i);
+        char raw[96];
+        msgText(g, m, raw, sizeof(raw));
+        char lines[4][40];
+        int nl = wrap(raw, lines, 4, k_wrapChars);
+        int w = 0;
+        for (int l = 0; l < nl; l++) {
+          int lw = textWidth(lines[l]);
+          w = lw > w ? lw : w;
+        }
+        int h = nl * lh + 8;
+        Rect bub = {m.me ? 312 - w - 16 : 8, y - h, w + 16, h};
+        y -= h + 6;
+        if (!bub.intersects(b.clip())) {
+          continue;
+        }
+        roundFill(b, bub, 10, rgb(m.me ? k_pink : 0xEDE1E7));
+        for (int l = 0; l < nl; l++) {
+          text(b, lines[l], bub.x + 8, bub.y + 4 + l * lh,
+               rgb(m.me ? 0xFFFFFF : k_ink));
+        }
+      }
+      b.resetClip();
+    }
+  }
+  // replies
+  if (b.area().intersects(k_chatReplies)) {
+    fill(b, k_chatReplies, rgb(0xFFFFFF));
+    fill(b, {0, k_chatReplies.y, 320, 1}, rgb(k_soft));
+    for (int i = 0; i < 3; i++) {
+      Rect r = {10, k_chatReplies.y + 5 + i * 24, 300, 21};
+      char t[64];
+      replyText(i, t, sizeof(t));
+      bool sel = s.reply == i;
+      bool busy = s.typing > 0;
+      uint32_t color = i == 0 ? k_like : (i == 1 ? k_pink : 0x8C7A85);
+      roundFill(b, r, 10, rgb(sel ? color : 0xFFFFFF), busy ? 120 : 256);
+      roundFrame(b, r, 10, rgb(color), busy ? 120 : 256);
+      text(b, t, r.x + 12, r.y + 3, rgb(sel ? 0xFFFFFF : k_ink),
+           KDFont::Size::Small, Align::Left, r.w - 20);
+    }
+  }
+}
+
+/* ------------------------------------------------------------------ kit */
+
+Rect kitCell(int i) {
+  return {10 + (i % 3) * 102, 50 + (i / 3) * 62, 96, 58};
+}
+
+void drawKit(Band& b) {
