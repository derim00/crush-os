+  float v = Battery::voltage();
+  int p = static_cast<int>((v - 3.6f) * 100.f / (4.15f - 3.6f));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
+
+uint32_t lighten(uint32_t c, int t256) {
+  int r = (c >> 16) & 255, g = (c >> 8) & 255, b = c & 255;
+  r += ((255 - r) * t256) >> 8;
+  g += ((255 - g) * t256) >> 8;
+  b += ((255 - b) * t256) >> 8;
+  return (r << 16) | (g << 8) | b;
+}
