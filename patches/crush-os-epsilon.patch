+#!/usr/bin/env python3
+"""Generate the CRUSH pictures for the NumWorks home screen.
+
+Every picture is an original drawing made of vector shapes in a 100x100
+design space, rendered with 8x supersampling, then exported as RGB565 +
+8-bit alpha:
+
+  - app tiles, big (46 px: the selected tile) and small (30 px: the row):
+    flat squares with a diagonal gradient and the symbol of the app;
+  - the symbol alone, white, 76 px: the key art of the selected app;
+  - the icons of the top bar, sparkles and the charging bolt.
+
+Usage: gen_icons.py <output_header.h> [--preview preview.png]
+"""
+
+
+import math
+import sys
+
+from PIL import Image, ImageDraw, ImageFont
+
+SS = 8
+D = 100
+
+FONT_PATHS = [
+    ("/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf", 0),
+    ("/System/Library/Fonts/Helvetica.ttc", 1),
+    ("/System/Library/Fonts/Supplemental/Arial Bold.ttf", 0),
+    ("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 0),
+]
+
+
+def font(size):
+    for path, index in FONT_PATHS:
+        try:
+            return ImageFont.truetype(path, size, index=index)
+        except Exception:
+            continue
+    return ImageFont.load_default()
+
+
+def hexc(v, a=255):
+    return ((v >> 16) & 255, (v >> 8) & 255, v & 255, a)
+
+
+WHITE = hexc(0xFFFFFF)
+CLEAR = (0, 0, 0, 0)
+
+
+
+class Painter:
+    """ImageDraw replaces pixels: translucent shapes are drawn on a layer and
+    composited over the picture instead."""
+
+    def __init__(self, img):
+        self.img = img
+        self.base = ImageDraw.Draw(img)
+
+    def __getattr__(self, method):
+        def paint(*args, **kwargs):
+            colours = [kwargs.get("fill"), kwargs.get("outline")]
+            translucent = any(isinstance(c, tuple) and len(c) == 4 and 0 < c[3] < 255
+                              for c in colours)
+            if not translucent:
+                return getattr(self.base, method)(*args, **kwargs)
+            layer = Image.new("RGBA", self.img.size, CLEAR)
+            getattr(ImageDraw.Draw(layer), method)(*args, **kwargs)
+            self.img.alpha_composite(layer)
+        return paint
+
+
+class Canvas:
+    def __init__(self, w=D, h=D):
+        self.w, self.h = w, h
+        self.img = Image.new("RGBA", (w * SS, h * SS), CLEAR)
+        self.d = Painter(self.img)
+
+    def s(self, v):
+        return v * SS
+
+    def box(self, x0, y0, x1, y1):
+        return [self.s(x0), self.s(y0), self.s(x1), self.s(y1)]
+
+    def rrect(self, x0, y0, x1, y1, r, fill=WHITE, outline=None, width=0):
+        self.d.rounded_rectangle(self.box(x0, y0, x1, y1), radius=self.s(r),
+                                 fill=fill, outline=outline,
+                                 width=int(round(self.s(width))) if width else 0)
+
+    def rect(self, x0, y0, x1, y1, fill=WHITE):
+        self.d.rectangle(self.box(x0, y0, x1, y1), fill=fill)
+
+    def circle(self, cx, cy, r, fill=WHITE, outline=None, width=0):
+        self.d.ellipse(self.box(cx - r, cy - r, cx + r, cy + r), fill=fill,
+                       outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def ellipse(self, x0, y0, x1, y1, fill=WHITE, outline=None, width=0):
+        self.d.ellipse(self.box(x0, y0, x1, y1), fill=fill, outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def poly(self, pts, fill=WHITE, outline=None, width=0):
+        self.d.polygon([(self.s(x), self.s(y)) for x, y in pts], fill=fill,
+                       outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def line(self, pts, width, fill=WHITE, round_caps=True):
+        p = [(self.s(x), self.s(y)) for x, y in pts]
+        w = int(round(self.s(width)))
+        self.d.line(p, fill=fill, width=w, joint="curve")
+        if round_caps:
+            for x, y in (p[0], p[-1]):
+                self.d.ellipse([x - w / 2, y - w / 2, x + w / 2, y + w / 2], fill=fill)
+
+    def arc(self, cx, cy, r, a0, a1, width, fill=WHITE):
+        self.d.arc(self.box(cx - r, cy - r, cx + r, cy + r), a0, a1, fill=fill,
+                   width=int(round(self.s(width))))
+
+    def text(self, cx, cy, t, size, fill=WHITE):
+        f = font(int(self.s(size)))
+        self.d.text((self.s(cx), self.s(cy)), t, font=f, fill=fill, anchor="mm")
+
+    def render(self, w, h=None):
+        if h is None:
+            h = round(w * self.h / self.w)
+        return self.img.resize((w, h), Image.LANCZOS)
+
+
+# CRUSH colours
+INK = 0x2E3440          # symbol shadows
+FRAME = 0xF4F5F7        # tile frame
+
+
+ART = False  # symbol only (key art): no tile, no shadow
+
+
+def gradient_square(c, top, bottom, r=12, inset=1):
+    """A flat tile with a diagonal gradient, like a living-room console."""
+    if ART:
+        return
+    s = c.s
+    mask = Image.new("L", c.img.size, 0)
+    ImageDraw.Draw(mask).rounded_rectangle(
+        [s(inset), s(inset), s(D - inset), s(D - inset)], radius=s(r), fill=255)
+    t, b = hexc(top), hexc(bottom)
+    n = c.img.size[0]
+    grad = Image.new("RGBA", c.img.size)
+    gd = ImageDraw.Draw(grad)
+    # diagonal: light in the top-left corner, deep in the bottom-right one
+    for k in range(2 * n):
+        f = min(1.0, k / (1.6 * n))
+        col = tuple(int(t[i] + (b[i] - t[i]) * f) for i in range(4))
+        gd.line([(k, 0), (0, k)], fill=col, width=2)
+    layer = Image.new("RGBA", c.img.size, CLEAR)
+    layer.paste(grad, (0, 0), mask)
+    c.img.alpha_composite(layer)
+    # soft light from the top
+    glow = Image.new("RGBA", c.img.size, (255, 255, 255, 0))
+    gm = Image.new("L", c.img.size, 0)
+    ImageDraw.Draw(gm).ellipse([s(-30), s(-70), s(90), s(40)], fill=46)
+    m2 = Image.new("L", c.img.size, 0)
+    m2.paste(gm, (0, 0), mask)
+    glow.putalpha(m2)
+    c.img.alpha_composite(glow)
+
+
+def sym(c, fn):
+    """Draws a white symbol with a soft drop shadow under it."""
+    if ART:
+        fn(c, WHITE)
+        return
+    shadow = Canvas()
+    fn(shadow, hexc(INK, 90))
+    sh = shadow.img.copy()
+    c.img.alpha_composite(sh, (0, int(c.s(2.5))))
+    fn(c, WHITE)
+
+
+COLOURS = {
+    "orange": (0xFFB347, 0xF0711C),
+    "green": (0x8CE071, 0x2FA84F),
+    "teal": (0x5CE1D2, 0x139E9A),
+    "purple": (0xC59BFF, 0x7B4BDB),
+    "pink": (0xFF9FCB, 0xE2457F),
+    "yellow": (0xFFE066, 0xE7A813),
+    "blue": (0x7CC8FF, 0x1E78E0),
+    "indigo": (0x9AA7FF, 0x4352C9),
+    "gold": (0xF7D774, 0xC48A12),
+    "python": (0x6AA7F2, 0x2B5FB0),
+    "red": (0xFF8A80, 0xD9312B),
+    "grey": (0xD7DCE2, 0x8892A0),
+    "game": (0xFF6E6E, 0xB3202B),
+}
+
+
+def icon_calculation(c):
+    gradient_square(c, *COLOURS["orange"])
+
+    def f(c, col):
+        c.rrect(30, 22, 70, 80, 8, fill=col)
+        hole = hexc(COLOURS["orange"][1]) if col == WHITE else col
+        c.rrect(36, 28, 64, 42, 3, fill=hole)
+        for i in range(3):
+            for j in range(3):
+                c.rrect(36 + i * 10, 48 + j * 10, 43 + i * 10, 54 + j * 10, 2, fill=hole)
+    sym(c, f)
+
+
+def icon_graph(c):
+    gradient_square(c, *COLOURS["green"])
+
+    def f(c, col):
+        c.line([(24, 80), (24, 22)], 3.5, fill=col)
+        c.line([(20, 66), (82, 66)], 3.5, fill=col)
+        pts = [(24 + i * 1.3, 52 - 22 * math.sin(i * 1.3 / 56 * math.pi * 2)) for i in range(45)]
+        c.line(pts, 6.5, fill=col)
+    sym(c, f)
+
+
+def icon_solver(c):
+    gradient_square(c, *COLOURS["teal"])
+    sym(c, lambda c, col: c.text(50, 50, "x=?", 30, fill=col))
+
+
+def icon_statistics(c):
+    gradient_square(c, *COLOURS["purple"])
+
+    def f(c, col):
+        for i, h in enumerate((22, 40, 30, 50)):
+            x = 22 + i * 15
+            c.rrect(x, 78 - h, x + 11, 78, 3, fill=col)
+    sym(c, f)
+
+
+def icon_distributions(c):
+    gradient_square(c, *COLOURS["pink"])
+
+    def f(c, col):
+        pts = [(16 + i * 2, 78 - 48 * math.exp(-(((16 + i * 2) - 50) / 13) ** 2)) for i in range(35)]
+        c.poly(pts + [(84, 78), (16, 78)], fill=hexc(0xFFFFFF, 90) if col == WHITE else col)
+        c.line(pts, 6, fill=col)
+    sym(c, f)
+
+
+def icon_sequence(c):
+    gradient_square(c, *COLOURS["yellow"])
+
+    def f(c, col):
+        for i in range(5):
+            c.circle(22 + i * 14, 74 - i * i * 2.6 - i * 3, 5.5, fill=col)
+        c.text(36, 30, "un", 22, fill=col)
+    sym(c, f)
+
+
+def icon_regression(c):
+    gradient_square(c, *COLOURS["blue"])
+
+    def f(c, col):
+        for x, y in ((24, 74), (33, 64), (40, 68), (50, 54), (58, 50), (68, 40), (76, 36)):
+            c.circle(x, y, 4.5, fill=col)
+        c.line([(18, 80), (82, 30)], 3.6, fill=col)
+    sym(c, f)
+
+
+def icon_inference(c):
+    gradient_square(c, *COLOURS["indigo"])
+
+    def f(c, col):
+        c.circle(44, 44, 17, fill=None, outline=col, width=7)
+        c.line([(56, 57), (74, 75)], 10, fill=col)
+    sym(c, f)
+
+
+def icon_finance(c):
+    gradient_square(c, *COLOURS["gold"])
+
+    def f(c, col):
+        c.circle(50, 50, 26, fill=None, outline=col, width=5)
+        c.text(50, 51, "€", 34, fill=col)
+    sym(c, f)
+
+
+def icon_code(c):
+    gradient_square(c, *COLOURS["python"])
+    blue, yellow = hexc(0x2B5FB0), hexc(0xFFD43B)
+    # the two snakes of the logo, drawn as simple rounded shapes
