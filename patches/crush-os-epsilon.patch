+/* ------------------------------------------------------------- shell */
+
+namespace Shell {
+
+void photoSession();
+
+void setInvalidator(void (*inv)(Rect)) { s_invalidate = inv; }
+
+void setPainter(void (*p)(Rect)) { s_painter = p; }
+
+void enter() {
+  listApps();
+  s_rand ^= static_cast<uint32_t>(Ion::Timing::millis()) * 2654435761u;
+  s.launching = false;
+  s.zoomR = 0;
+  s.swipe = 0;
+  s.bounce = 0;
+  s_launch = k_noItem;
+  int n = numberOfItems();
+  if (s.top >= n) {
+    s.top = 0;
+  }
+  if (!s.booted) {
+    s.booted = true;
+    s.screen = Screen::Intro;
+    s.intro = 0;
+  } else if (s.screen == Screen::Intro || s.screen == Screen::Match) {
+    s.screen = Screen::Main;
+  }
+  // back from a date
+  int g = s.lastLaunched;
+  if (g >= 0 && g < n && s_conv[g].matched && s.dateAfter) {
+    push(g, MsgBack, rnd() % k_variants);
+    if (s.screen == Screen::Chat && s.chat == g) {
+      s_conv[g].unread = 0;
+    }
+  }
+  s.dateAfter = false;
+  // sometimes, an app calls you when you come back
+  if (s.screen != Screen::Intro && s.launches >= 2 && rnd() % 3 == 0) {
+    int list[k_maxItems];
+    int m = matchedList(list);
+    int candidates = 0;
+    for (int i = 0; i < m; i++) {
+      candidates += list[i] != g ? 1 : 0;
+    }
+    if (candidates > 0) {
+      int pick = rnd() % candidates;
+      for (int i = 0; i < m; i++) {
+        if (list[i] != g && pick-- == 0) {
+          s.callItem = list[i];
+          s.callT = 0;
+          s.screen = Screen::Call;
+          break;
+        }
+      }
+    }
+  }
+  if (s.screen == Screen::Call && (s.callItem < 0 || s.callItem >= n)) {
+    s.screen = Screen::Main;
+  }
+  if (s.screen == Screen::Chat && (s.chat < 0 || s.chat >= n ||
+                                   !s_conv[s.chat].matched)) {
+    s.screen = Screen::Main;
+  }
+  if (s.screen == Screen::Tool && s.tool == ToolPanic) {
+    s.screen = Screen::Main;
+  }
+#if !PLATFORM_DEVICE
+  static bool s_photoDone = false;
+  if (!s_photoDone && getenv("DS_SHOTS")) {
+    s_photoDone = true;
+    photoSession();
+    listApps();
+  }
+#endif
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+void launchFailed() {
+  s.launching = false;
+  s.zoomR = 0;
+  toast("Mode examen : pas de rdv.");
+  invalidateAll();
+}
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  bool ok = e == Events::OK || e == Events::EXE;
+  bool typing = s.screen == Screen::Tool &&
+                (s.tool == ToolLove || s.tool == ToolBoard);
+  // the panic key, everywhere
+  if (e == Events::Zero && !typing && s.screen != Screen::Intro) {
+    panic();
+    return true;
+  }
+  switch (s.screen) {
+    case Screen::Intro:
+      if (s.intro < k_introCrash) {
+        s.intro = k_introCrash;
+      } else if (s.intro < k_introFrames) {
+        s.intro = k_introFrames;
+      } else if (ok || e == Events::Home || e == Events::Back) {
+        s.screen = Screen::Main;
+        s.tab = TabDeck;
+      }
+      invalidateAll();
+      return true;
+    case Screen::Match:
+      if (ok) {
+        launchItem(s.matchItem, true);
+        if (s_launch.isNone()) {
+          s.screen = Screen::Main;
+        }
+        s.dateAfter = true;
+      } else if (e == Events::Back || e == Events::Home) {
+        s.screen = Screen::Main;
+        invalidateAll();
+      } else if (e == Events::Right) {
+        // directly to the conversation
+        openChat(s.matchItem);
+      }
+      return true;
+    case Screen::Chat:
+      if (e == Events::Back || e == Events::Home || e == Events::Left) {
+        s.screen = Screen::Main;
+        s.tab = TabMessages;
+        invalidateAll();
+        return true;
+      }
+      if (s.typing > 0) {
+        return true;
+      }
+      if (e == Events::Up && s.reply > 0) {
+        s.reply--;
+        paint(k_chatReplies);
+      } else if (e == Events::Down && s.reply < 2) {
+        s.reply++;
+        paint(k_chatReplies);
+      } else if (ok) {
+        sendReply();
+      }
+      return true;
+    case Screen::Tool:
+      if (e == Events::Back || e == Events::Home) {
+        if (s.tool == ToolClock && k.clockRunning && e == Events::Back) {
+          // the countdown keeps running in the background
+        }
+        s.screen = Screen::Main;
+        s.tab = TabKit;
+        invalidateAll();
+        return true;
+      }
+      return toolEvent(e);
+    case Screen::Call:
+      if (ok) {
+        int g = s.callItem;
+        s.screen = Screen::Main;
+        s.dateAfter = true;
+        launchItem(g, true);
+      } else if (e == Events::Back || e == Events::Home) {
+        Conv& c = s_conv[s.callItem];
+        push(s.callItem, MsgHangup);
+        if (c.affection > 1) {
+          c.affection--;
+        }
+        s.screen = Screen::Main;
+        char t[64];
+        format(t, sizeof(t), "Tu as raccroche au nez de %s.",
+               itemLabel(s.callItem));
+        toast(t);
+      }
+      return true;
+    case Screen::Main:
+      break;
+  }
+  if (tabKey(e)) {
+    return true;
+  }
+  switch (s.tab) {
+    case TabDeck:
+      if (s.swipe != 0) {
+        return true;
+      }
+      if (e == Events::Left) {
+        startSwipe(-1);
+      } else if (e == Events::Right || ok) {
+        startSwipe(1);
+      } else if (e == Events::Up) {
+        startSwipe(2);
+      } else if (e == Events::Backspace && s.lastNope >= 0) {
+        s.top = s.lastNope;
+        s.lastNope = -1;
+        toast("Retour arriere (Crush Gold offert)");
+        paint(k_content);
+      } else if (e == Events::Down) {
+        toast("Timide. Swipe pour voir.");
+      }
+      return true;
+    case TabMessages: {
+      int list[k_maxItems];
+      int n = matchedList(list);
+      if (e == Events::Up) {
+        if (s.msgSel > 0) {
+          s.msgSel--;
+        }
+      } else if (e == Events::Down) {
+        if (s.msgSel < n - 1) {
+          s.msgSel++;
+        }
+      } else if (ok && n > 0) {
+        openChat(list[s.msgSel]);
+        return true;
+      } else if (e == Events::Back || e == Events::Left) {
+        setTab(TabDeck);
+        return true;
+      }
+      if (s.msgSel < s.msgScroll) {
+        s.msgScroll = s.msgSel;
+      }
+      if (s.msgSel >= s.msgScroll + k_visibleRows) {
+        s.msgScroll = s.msgSel - k_visibleRows + 1;
+      }
+      paint(k_content);
+      return true;
+    }
+    case TabKit:
+      if (e == Events::Left && s.kitSel % 3 > 0) {
+        s.kitSel--;
+      } else if (e == Events::Right && s.kitSel % 3 < 2) {
+        s.kitSel++;
+      } else if (e == Events::Up && s.kitSel >= 3) {
+        s.kitSel -= 3;
+      } else if (e == Events::Down && s.kitSel < 6) {
+        s.kitSel += 3;
+      } else if (ok) {
+        openTool(s.kitSel);
+        return true;
+      } else if (e == Events::Back) {
+        setTab(TabDeck);
+        return true;
+      }
+      paint(k_content);
+      return true;
+    case TabProfile:
+      if (e == Events::Back) {
+        setTab(TabDeck);
+      }
+      return true;
+  }
+  return false;
+}
+
+bool tick() {
+  int battery = batteryPercent();
+  if (battery != s.battery) {
+    s.battery = battery;
+    if (s.screen == Screen::Main) {
+      invalidate({270, 0, 50, 22});
+    }
+  }
+  return false;
+}
+
+int framePeriod() { return k_framePeriod; }
+
+bool frame() {
+  s.phase++;
+  if (s.launching) {
+    return false;
+  }
+  if (s.toastT > 0) {
+    s.toastT--;
+    if (s.screen == Screen::Main) {
+      paint({0, 170, 320, 50});
+    }
+  }
+  switch (s.screen) {
+    case Screen::Intro:
+      if (s.intro < k_introFrames) {
+        s.intro++;
+        paint(k_screen);
+      } else {
+        paint(k_screen);
+      }
+      return false;
+    case Screen::Match:
+      if (s.matchT < k_matchFrames) {
+        s.matchT++;
+      }
+      paint(k_screen);
+      return false;
+    case Screen::Chat:
+      if (s.typing > 0) {
+        s.typing--;
+        if (s.typing == 0 && s.pending >= 0) {
+          answerArrives();
+          return false;
+        }
+        paint({0, 0, 320, 164});
+      }
+      return false;
+    case Screen::Tool:
+      toolFrame();
+      return false;
+    case Screen::Call:
+      s.callT++;
+      paint(k_screen);
+      return false;
+    case Screen::Main:
+      break;
+  }
+  // the logo beats
+  if (s.phase % 25 == 0 || s.phase % 25 == 3) {
+    paint({4, 2, 20, 20});
+  }
+  if (s.tab == TabDeck) {
+    for (int i = 0; i < 3; i++) {
+      if (s.press[i] > 0) {
+        s.press[i]--;
+        paint({80, 206, 160, 34});
+      }
+    }
+    if (s.swipe != 0) {
+      s.swipeT++;
+      paint(k_content);
+      if (s.swipeT >= k_swipeFrames) {
+        finishSwipe();
+      }
+    } else if (s.bounce > 0) {
+      s.bounce--;
+      paint({0, 24, 320, 182});
+    } else if (s.phase % 2 == 0 && numberOfItems() > 0) {
+      // floating hearts in the photo, the symbol bobbing
+      paint({k_card.x + 6, k_card.y + 6, k_card.w - 12, k_photoH});
+    }
+  }
+  return false;
+}
+
+void render(Band& b) {
+  Ds::render(b);
+}
