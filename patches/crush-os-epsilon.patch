+}  // namespace Shell
+
+namespace {
+
+void render(Band& b) {
+  if (s.launching) {
+    drawZoom(b);
+    return;
+  }
+  switch (s.screen) {
+    case Screen::Intro:
+      drawIntro(b);
+      return;
+    case Screen::Match:
+      drawMatch(b);
+      return;
+    case Screen::Chat:
+      drawChat(b);
+      return;
+    case Screen::Tool:
+      drawTool(b);
+      return;
+    case Screen::Call:
+      drawCall(b);
+      return;
+    case Screen::Main:
+      break;
+  }
+  drawTopBar(b);
+  switch (s.tab) {
+    case TabDeck:
+      drawDeck(b);
+      break;
+    case TabMessages:
+      drawMessages(b);
+      break;
+    case TabKit:
+      drawKit(b);
+      break;
+    case TabProfile:
+      drawProfile(b);
+      break;
+  }
+  drawToast(b);
+}
