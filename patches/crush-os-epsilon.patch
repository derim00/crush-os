+void cardOffset(int* dx, int* dy) {
+  *dx = 0;
+  *dy = 0;
+  if (s.swipe != 0) {
+    float t = easeIn(s.swipeT / static_cast<float>(k_swipeFrames));
+    if (s.swipe == 2) {
+      *dy = static_cast<int>(-260 * t);
+    } else {
+      *dx = static_cast<int>(s.swipe * 330 * t);
+      *dy = static_cast<int>(30 * t);
+    }
+  } else if (s.bounce > 0) {
+    float t = s.bounce / static_cast<float>(k_bounceFrames);
+    *dx = static_cast<int>(-50 * sinf(t * 3.14159f));
+  }
+}
