+// Copies tpl into out, %s replaced by str
+void format(char* out, int size, const char* tpl, const char* str) {
+  int n = 0;
+  for (const char* c = tpl; *c && n < size - 1; c++) {
+    if (c[0] == '%' && c[1] == 's') {
+      for (const char* t = str; t && *t && n < size - 1; t++) {
+        out[n++] = *t;
+      }
+      c++;
+    } else {
+      out[n++] = *c;
+    }
+  }
+  out[n] = 0;
+}
+
+int appendText(char* buf, int i, const char* t, int size = 64) {
+  while (*t && i < size - 1) {
+    buf[i++] = *t++;
+  }
+  buf[i] = 0;
+  return i;
+}
+
+int appendInt(char* buf, int i, int v) {
+  if (v < 0) {
+    buf[i++] = '-';
+    v = -v;
+  }
+  char digits[12];
+  int n = 0;
+  do {
+    digits[n++] = '0' + v % 10;
+    v /= 10;
+  } while (v > 0);
+  while (n > 0) {
+    buf[i++] = digits[--n];
+  }
+  buf[i] = 0;
+  return i;
+}
+
+// strstr is not in the calculator's libc
+bool contains(const char* hay, const char* needle) {
+  for (; *hay; hay++) {
+    const char* h = hay;
+    const char* n = needle;
+    while (*n && *h == *n) {
+      h++;
+      n++;
+    }
+    if (*n == 0) {
+      return true;
+    }
+  }
+  return false;
+}
