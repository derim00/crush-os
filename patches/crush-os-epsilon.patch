+
+void openChat(int g) {
+  s.chat = g;
+  s.reply = 1;
+  s.typing = 0;
+  s.pending = -1;
+  s_conv[g].unread = 0;
+  s.screen = Screen::Chat;
+  invalidateAll();
+}
+
+void sendReply() {
+  int g = s.chat;
+  Conv& c = s_conv[g];
+  int var = (c.count + g) % k_variants;
+  if (s.reply == 0) {
+    push(g, MsgMeDate, 0, -1, true);
+    push(g, MsgAnsDate);
+    c.unread = 0;
+    c.dated = true;
+    s.dateAfter = true;
+    paint(k_screen);
+    if (s_painter) {
+      waitUntil(Ion::Timing::millis() + 700);
+    }
+    launchItem(g, true);
+    return;
+  } else if (s.reply == 1) {
+    push(g, MsgMeCute, var, -1, true);
+    s.pending = MsgAnsCute;
+  } else {
+    push(g, MsgMeTroll, var, -1, true);
+    s.pending = MsgAnsTroll;
+    s.trolls++;
+  }
+  s.pendingVar = var;
+  s.typing = 18 + rnd() % 14;
+  c.unread = 0;
+  invalidateAll();
+}
+
+void answerArrives() {
+  int g = s.chat;
+  Conv& c = s_conv[g];
+  int kind = s.pending;
+  s.pending = -1;
+  push(g, kind, s.pendingVar);
+  c.unread = 0;
+  if (kind == MsgAnsCute) {
+    if (c.affection < 5) {
+      c.affection++;
+    }
+    if (c.affection == 5 && !c.couple) {
+      c.couple = true;
+      push(g, MsgCouple);
+      c.unread = 0;
+    }
+  } else if (kind == MsgAnsTroll) {
+    c.affection--;
+    if (c.affection <= 0) {
+      c.matched = false;
+      c.unmatched = true;
+      c.couple = false;
+      c.affection = 0;
+      s.breakups++;
+      char t[64];
+      format(t, sizeof(t), "%s t'a unmatch. Bien fait.", itemLabel(g));
+      s.screen = Screen::Main;
+      s.tab = TabMessages;
+      s.msgSel = 0;
+      s.msgScroll = 0;
+      s.chat = -1;
+      toast(t);
+      return;
+    }
+  } else if (kind == MsgAnsDate) {
+    c.dated = true;
+    s.dateAfter = true;
+  }
+  invalidateAll();
+}
+
+/* ------------------------------------------------------- tools logic */
+
+char keyLetter(Event e) {
+  struct KeyLetter {
+    Event e;
+    char c;
+  };
+  static const KeyLetter k_keys[] = {
+      {Events::Exp, 'A'},          {Events::Ln, 'B'},
+      {Events::Log, 'C'},          {Events::Imaginary, 'D'},
+      {Events::Comma, 'E'},        {Events::Power, 'F'},
+      {Events::Sine, 'G'},         {Events::Cosine, 'H'},
+      {Events::Tangent, 'I'},      {Events::Pi, 'J'},
+      {Events::Sqrt, 'K'},         {Events::Square, 'L'},
+      {Events::Seven, 'M'},        {Events::Eight, 'N'},
+      {Events::Nine, 'O'},         {Events::LeftParenthesis, 'P'},
+      {Events::RightParenthesis, 'Q'}, {Events::Four, 'R'},
+      {Events::Five, 'S'},         {Events::Six, 'T'},
+      {Events::Multiplication, 'U'}, {Events::Division, 'V'},
+      {Events::One, 'W'},          {Events::Two, 'X'},
+      {Events::Three, 'Y'},        {Events::Plus, 'Z'},
+      {Events::Minus, ' '},
+  };
+  for (const KeyLetter& kl : k_keys) {
+    if (kl.e == e) {
+      return kl.c;
+    }
+  }
+  const char* t = e.text();
+  if (t && t[0] && !t[1]) {
+    char c = t[0];
+    if (c >= 'a' && c <= 'z') {
+      return c - 32;
+    }
+    if (c >= 'A' && c <= 'Z') {
+      return c;
+    }
+  }
+  return 0;
+}
+
+int lovePercent() {
+  // order does not matter: "Lea + Tom" is "Tom + Lea"
+  uint32_t h[2];
+  for (int n = 0; n < 2; n++) {
+    h[n] = 5381;
+    for (const char* c = k.names[n]; *c; c++) {
+      char ch = (*c >= 'a' && *c <= 'z') ? *c - 32 : *c;
+      if (ch != ' ') {
+        h[n] = h[n] * 33 + static_cast<uint8_t>(ch);
+      }
+    }
+  }
+  uint32_t mix = (h[0] ^ h[1]) * 2654435761u + (h[0] + h[1]);
+  int p = static_cast<int>((mix >> 7) % 101);
+  char lower[2][13];
+  for (int n = 0; n < 2; n++) {
+    int j = 0;
+    for (; k.names[n][j]; j++) {
+      char ch = k.names[n][j];
+      lower[n][j] = (ch >= 'A' && ch <= 'Z') ? ch + 32 : ch;
+    }
+    lower[n][j] = 0;
+  }
+  if (contains(lower[0], "prof") || contains(lower[1], "prof")) {
+    return 0;
+  }
+  if (strcmp(lower[0], lower[1]) == 0) {
+    return 100;
+  }
+  return p;
+}
+
+void newExcuse() {
+  k.excuse[0] = rnd() % count(k_ex1);
+  k.excuse[1] = rnd() % count(k_ex2);
+  k.excuse[2] = rnd() % count(k_ex3);
+  k.excuse[3] = rnd() % count(k_ex4);
+  k.excuseT = 0;
+}
+
+void openTool(int t) {
+  s.tool = t;
+  s.toolT = 0;
+  s.screen = Screen::Tool;
+  switch (t) {
+    case ToolLove:
+      k.lovePct = -1;
+      k.field = k.names[0][0] ? 1 : 0;
+      break;
+    case ToolExcuse:
+      newExcuse();
+      break;
+    case ToolCrack:
+      k.cracks = 1;
+      k.crackSeed[0] = rnd() * 7919u + 17;
+      break;
+    case ToolLie:
+      k.lieState = 0;
+      k.lieRig = 0;
+      break;
+    case ToolBoard:
+      k.boardState = 0;
+      break;
+    case ToolUpdate:
+      k.updateStart = nowMs();
+      break;
+    case ToolBall:
+      k.ballState = 0;
+      break;
+    default:
+      break;
+  }
+  invalidateAll();
+}
+
+bool toolEvent(Event e) {
+  bool ok = e == Events::OK || e == Events::EXE;
+  switch (s.tool) {
+    case ToolPanic:
+      if (ok) {
+        panic();
+      }
+      return true;
+    case ToolLove: {
+      if (k.lovePct >= 0) {
+        if (ok) {
+          k.lovePct = -1;
+          k.names[0][0] = k.names[1][0] = 0;
+          k.field = 0;
+          invalidateAll();
+        }
+        return true;
+      }
+      char* name = k.names[k.field];
+      int len = strlen(name);
+      if (e == Events::Up || e == Events::Down) {
+        k.field = 1 - k.field;
+      } else if (e == Events::Backspace) {
+        if (len > 0) {
+          name[len - 1] = 0;
+        } else {
+          k.field = 0;
+        }
+      } else if (ok) {
+        if (k.field == 0 && k.names[0][0]) {
+          k.field = 1;
+        } else if (k.names[0][0] && k.names[1][0]) {
+          k.lovePct = lovePercent();
+          k.loveT = 0;
+        }
+      } else {
+        char c = keyLetter(e);
+        if (c && len < 11 && !(c == ' ' && len == 0)) {
+          name[len] = len == 0 ? c : (c == ' ' ? c : c + 32);
+          name[len + 1] = 0;
+        }
+      }
+      invalidateAll();
+      return true;
+    }
+    case ToolExcuse:
+      if (ok) {
+        newExcuse();
+        invalidateAll();
+      }
+      return true;
+    case ToolCrack:
+      // every key breaks it a little more
+      if (k.cracks < 8) {
+        k.crackSeed[k.cracks++] = rnd() * 7919u + s.phase;
+      }
+      invalidateAll();
+      return true;
+    case ToolLie:
+      if (e == Events::Plus) {
+        k.lieRig = 1;
+      } else if (e == Events::Minus) {
+        k.lieRig = 2;
+      } else if (ok && k.lieState != 1) {
+        k.lieState = 1;
+        k.lieT = 0;
+      }
+      invalidateAll();
+      return true;
+    case ToolBoard:
+      if (k.boardState == 0) {
+        if (e == Events::Left && k.boardN > 2) {
+          k.boardN--;
+        } else if (e == Events::Right && k.boardN < 99) {
+          k.boardN++;
+        } else if (e == Events::Down && k.boardN > 11) {
+          k.boardN -= 10;
+        } else if (e == Events::Up && k.boardN < 90) {
+          k.boardN += 10;
+        }
+      }
+      {
+        // digits secretly choose the next number (shh)
+        const Event digitsKeys[10] = {
+            Events::Zero, Events::One, Events::Two,   Events::Three,
+            Events::Four, Events::Five, Events::Six, Events::Seven,
+            Events::Eight, Events::Nine};
+        for (int d = 0; d < 10; d++) {
+          if (e == digitsKeys[d]) {
+            k.boardForced = (k.boardForced * 10 + d) % 100;
+            return true;
+          }
+        }
+      }
+      if (ok && k.boardState != 1) {
+        k.boardState = 1;
+        k.boardT = 0;
+        if (k.boardForced >= 1 && k.boardForced <= k.boardN) {
+          k.boardResult = k.boardForced;
+        } else {
+          k.boardResult = 1 + rnd() % k.boardN;
+        }
+        k.boardForced = 0;
+      }
+      invalidateAll();
+      return true;
+    case ToolClock:
+      if (!k.clockRunning) {
+        if (e == Events::Left && k.clockMinutes > 1) {
+          k.clockMinutes--;
+        } else if (e == Events::Right && k.clockMinutes < 240) {
+          k.clockMinutes++;
+        } else if (e == Events::Down && k.clockMinutes > 5) {
+          k.clockMinutes -= 5;
+        } else if (e == Events::Up && k.clockMinutes < 235) {
+          k.clockMinutes += 5;
+        } else if (ok) {
+          k.clockRunning = true;
+          k.clockStart = nowMs();
+        }
+      } else if (ok) {
+        k.clockRunning = false;
+      }
+      invalidateAll();
+      return true;
+    case ToolUpdate:
+      return true;
+    case ToolBall:
+      if (ok && k.ballState != 1) {
+        k.ballState = 1;
+        k.ballT = 0;
+      }
+      invalidateAll();
+      return true;
+  }
+  return true;
+}
+
+void toolFrame() {
+  s.toolT++;
+  switch (s.tool) {
+    case ToolPanic:
+      if (s.phase % 8 == 0) {
+        paint({100, 40, 120, 110});
+      }
+      break;
+    case ToolLove:
+      if (k.lovePct >= 0 && k.loveT <= 34) {
+        k.loveT++;
+        paint({0, 30, 320, 210});
+      } else if (k.lovePct < 0 && s.phase % 8 == 0) {
+        paint({16, 40, 150, 70});
+      }
+      break;
+    case ToolExcuse:
+      if (k.excuseT < 80) {
+        k.excuseT++;
+        paint({0, 30, 320, 210});
+      }
+      break;
+    case ToolLie:
+      if (k.lieState == 1) {
+        k.lieT++;
+        if (k.lieT >= 70) {
+          k.lieState = 2;
+          if (k.lieRig == 1) {
+            k.lieResult = 0;
+          } else if (k.lieRig == 2) {
+            k.lieResult = rnd() % 2 ? 1 : 2;
+          } else {
+            int r = rnd() % 10;
+            k.lieResult = r < 4 ? 0 : (r < 7 ? 1 : (r < 9 ? 2 : 3));
+          }
+          k.lieRig = 0;
+        }
+        paint({0, 30, 320, 210});
+      }
+      break;
+    case ToolBoard:
+      if (k.boardState == 1) {
+        k.boardT++;
+        int interval = 1 + k.boardT / 10;
+        if (k.boardT % interval == 0) {
+          k.boardShown = 1 + rnd() % k.boardN;
+        }
+        if (k.boardT >= 50) {
+          k.boardState = 2;
+          k.boardShown = k.boardResult;
+        }
+        paint({0, 40, 320, 180});
+      }
+      break;
+    case ToolClock:
+      if (k.clockRunning && s.phase % 12 == 0) {
+        paint({0, 40, 320, 200});
+      }
+      break;
+    case ToolUpdate:
+      if (s.phase % 2 == 0) {
+        paint(k_screen);
+      }
+      break;
+    case ToolBall:
+      if (k.ballState == 1) {
+        k.ballT++;
+        if (k.ballT > 26) {
+          k.ballState = 2;
+          k.ballT = 0;
+          k.ballAnswer = rnd() % count(k_ball);
+        }
+        paint({60, 40, 200, 190});
+      } else if (k.ballState == 2 && k.ballT < 20) {
+        k.ballT++;
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+/* ------------------------------------------------------- tabs, focus */
+
+void setTab(int t) {
+  t = (t + 4) % 4;
+  s.tab = t;
+  s.msgSel = 0;
+  s.msgScroll = 0;
+  invalidateAll();
+}
+
+bool tabKey(Event e) {
+  if (e == Events::One) {
+    setTab(TabDeck);
+  } else if (e == Events::Two) {
+    setTab(TabMessages);
+  } else if (e == Events::Three) {
+    setTab(TabKit);
+  } else if (e == Events::Four) {
+    setTab(TabProfile);
+  } else if (e == Events::Toolbox || e == Events::Var) {
+    setTab(s.tab + 1);
+  } else if (e == Events::ShiftRight) {
+    setTab(s.tab + 1);
+  } else if (e == Events::ShiftLeft) {
+    setTab(s.tab - 1);
+  } else {
+    return false;
+  }
+  return true;
+}
