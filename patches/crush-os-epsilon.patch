+float clamp01(float t) { return t < 0.f ? 0.f : (t > 1.f ? 1.f : t); }
+float easeOut(float t) {
+  t = clamp01(t);
+  return 1.f - (1.f - t) * (1.f - t) * (1.f - t);
+}
+float easeIn(float t) {
+  t = clamp01(t);
+  return t * t;
+}
