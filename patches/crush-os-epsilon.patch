+    s_builtinLabel[s_numberOfBuiltin] =
+        p >= 0 ? k_profiles[p].label : I18n::translate(name);
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfApps() - builtin;
+  if (s_numberOfGames < 0) {
+    s_numberOfGames = 0;
+  }
+  if (s_numberOfBuiltin + s_numberOfGames > k_maxItems) {
+    s_numberOfGames = k_maxItems - s_numberOfBuiltin;
+  }
