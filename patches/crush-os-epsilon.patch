+
+void launchItem(int g, bool animate) {
+  if (g < 0 || g >= numberOfItems()) {
+    return;
+  }
+  s.launches++;
+  s.lastLaunched = g;
+  s_conv[g].lastLaunch = s.launches;
+  s_conv[g].ghosted = false;
+  s_conv[g].seen = false;
+  // jealousy: another match saw you
+  int list[k_maxItems];
+  int n = matchedList(list);
+  int candidates = 0;
+  for (int i = 0; i < n; i++) {
+    if (list[i] != g) {
+      candidates++;
+    }
+  }
+  if (candidates > 0 && rnd() % 3 != 0) {
+    int pick = rnd() % candidates;
+    for (int i = 0; i < n; i++) {
+      if (list[i] != g && pick-- == 0) {
+        push(list[i], MsgJealous, 0, static_cast<int8_t>(g));
+        break;
+      }
+    }
+  }
+  // ghosting: the ones you have not opened for a while
+  for (int i = 0; i < n; i++) {
+    Conv& c = s_conv[list[i]];
+    if (list[i] == g) {
+      continue;
+    }
+    if (!c.ghosted && s.launches - c.lastLaunch >= 4) {
+      c.ghosted = true;
+      push(list[i], MsgGhost);
+    } else if (c.ghosted && !c.seen && s.launches - c.lastLaunch >= 7) {
+      c.seen = true;
+      push(list[i], MsgSeen);
+    }
+  }
+  if (animate && s_painter) {
+    s.launching = true;
+    s.zoomItem = g;
+    uint32_t start = Ion::Timing::millis();
+    for (int i = 1; i <= 10; i++) {
+      s.zoomR = static_cast<int>(210 * easeOut(i / 10.f));
+      paint(k_screen);
+      waitUntil(start + i * 24);
+    }
+    for (int i = 0; i < 8; i++) {
+      s.phase++;
+      paint(k_screen);
+      waitUntil(Ion::Timing::millis() + 35);
+    }
+  }
+  if (!isGame(g)) {
+    s_launch = {Item::Kind::Builtin, s_builtin[g]};
+  } else {
+    s_launch = {Item::Kind::External,
+                static_cast<int16_t>(g - s_numberOfBuiltin)};
+  }
+}
+
+void panic() {
+  int g = findBuiltin(I18n::Message::CalculApp);
+  if (g < 0) {
+    g = 0;
+  }
+  s_launch = {Item::Kind::Builtin, s_builtin[g]};
+}
+
+/* -------------------------------------------------------- deck logic */
+
+void like(int g, bool super) {
+  Conv& c = s_conv[g];
+  s.likes++;
+  bool fresh = !c.matched;
+  if (fresh) {
+    c.matched = true;
+    c.affection = super ? 3 : 2;
+    c.unread = 0;
+    c.count = 0;
+    s.matches++;
+    push(g, MsgOpener);
+  }
+  s.matchItem = g;
+  s.matchT = 0;
+  s.superLike = super;
+  s.screen = Screen::Match;
+  s.top = nextItem(g);
+  invalidateAll();
+}
+
+void startSwipe(int dir) {
+  if (numberOfItems() == 0 || s.swipe != 0) {
+    return;
+  }
+  const Profile* p = profile(s.top);
+  if (dir < 0 && p && p->refuse) {
+    s.bounce = k_bounceFrames;
+    s.press[0] = 4;
+    toast(p->refuse);
+    return;
+  }
+  s.swipe = dir;
+  s.swipeT = 0;
+  s.press[dir < 0 ? 0 : (dir == 2 ? 1 : 2)] = 5;
+}
+
+void finishSwipe() {
+  int dir = s.swipe;
+  s.swipe = 0;
+  s.swipeT = 0;
+  int g = s.top;
+  if (dir < 0) {
+    s.nopes++;
+    if (s_conv[g].nopes < 255) {
+      s_conv[g].nopes++;
+    }
+    s.lastNope = g;
+    s.top = nextItem(g);
+    if (s_conv[g].nopes == 3) {
+      char t[64];
+      format(t, sizeof(t), "%s le prend mal.", itemLabel(g));
+      toast(t);
+    }
+    paint(k_content);
+  } else {
+    like(g, dir == 2);
+  }
+}
